<Page
x:Class="my_shop.App.Views.DashboardView"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:local="using:my_shop.App.Views"
xmlns:vm="using:my_shop.App.ViewModels"
xmlns:converters="using:my_shop.App.Converters"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:System="using:System"
mc:Ignorable="d">

<Page.Resources>
<converters:CurrencyConverter x:Key="CurrencyConverter"/>
<converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
<converters:InvertedBoolToOpacityConverter x:Key="InvertedBoolToOpacityConverter"/>
<converters:MonthlyTotalRevenueConverter x:Key="MonthlyTotalRevenueConverter"/>
<converters:MonthlyTotalOrdersConverter x:Key="MonthlyTotalOrdersConverter"/>
<converters:MonthlyAvgRevenueConverter x:Key="MonthlyAvgRevenueConverter"/>
    <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
        </Style>
    </Page.Resources>

    <Grid>
        <!-- Main Content -->
        <ScrollViewer x:Name="MainContent" Opacity="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InvertedBoolToOpacityConverter}}">
        <StackPanel Spacing="24" Padding="12">
            <!-- Header -->
            <StackPanel>
                <TextBlock Text="Dashboard" FontSize="32" FontWeight="SemiBold"/>
                <TextBlock Text="Welcome back! Here's what's happening today." 
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Statistics Cards Row -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Total Products -->
                <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7B8;" FontSize="17" Foreground="{ThemeResource SystemAccentColor}"/>
                            <TextBlock Text="Total Products" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock FontSize="24" FontWeight="Bold" Margin="0,8,0,0">
                            <Run Text="{x:Bind ViewModel.Stats.TotalProducts, Mode=OneWay, FallbackValue=0, TargetNullValue=0}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Today Orders -->
                <Border Grid.Column="1" Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7BF;" FontSize="17" Foreground="#10B981"/>
                                <TextBlock Text="Today's Orders" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock FontSize="24" FontWeight="Bold" Margin="0,8,0,0">
                            <Run Text="{x:Bind ViewModel.Stats.TodayOrders, Mode=OneWay, FallbackValue=0, TargetNullValue=0}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Today Revenue -->
                <Border Grid.Column="2" Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8A5;" FontSize="17" Foreground="#F59E0B"/>
                                <TextBlock Text="Today's Revenue" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock FontSize="24" FontWeight="Bold" Margin="0,8,0,0">
                            <Run Text="{x:Bind ViewModel.Stats.TodayRevenue, Mode=OneWay, Converter={StaticResource CurrencyConverter}, FallbackValue='0 đ', TargetNullValue='0 đ'}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Low Stock Alert -->
                <Border Grid.Column="3" Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7BA;" FontSize="17" Foreground="#EF4444"/>
                                <TextBlock Text="Low Stock Items" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock FontSize="24" FontWeight="Bold" Margin="0,8,0,0">
                            <Run Text="{x:Bind ViewModel.Stats.LowStockCount, Mode=OneWay, FallbackValue=0, TargetNullValue=0}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Two Columns Layout -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Recent Orders -->
                <Border Grid.Column="0" Grid.Row="0" Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Recent Orders" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <ListView ItemsSource="{x:Bind ViewModel.RecentOrders, Mode=OneWay}" 
                                 SelectionMode="None" MaxHeight="300">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <Border Grid.Column="0" Background="{ThemeResource AccentFillColorDefaultBrush}" 
                                               Width="40" Height="40" CornerRadius="20" Margin="0,0,12,0">
                                            <FontIcon Glyph="&#xE8B7;" FontSize="16" Foreground="White"/>
                                        </Border>
                                        
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding OrderId}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding CreatedTime}" FontSize="12" 
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="{Binding ItemCount}" FontSize="12" 
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text="items" FontSize="11" 
                                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                        </StackPanel>
                                        
                                        <TextBlock Grid.Column="3" Text="{Binding TotalPrice, Converter={StaticResource CurrencyConverter}}" 
                                                  FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- Low Stock Products -->
                <Border Grid.Column="1" Grid.Row="0" Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Low Stock Alert" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <TextBlock Text="Products running low (qty &lt; 5)" FontSize="12" 
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,12"/>
                        <ListView ItemsSource="{x:Bind ViewModel.LowStockProducts, Mode=OneWay}" 
                                 SelectionMode="None" MaxHeight="300">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Sku}" FontSize="11" 
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                        
                                        <Border Grid.Column="1" Background="#FEE2E2" CornerRadius="12" 
                                               Padding="8,4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Count}" FontSize="12" 
                                                      Foreground="#DC2626" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- Best Selling Products -->
                <Border Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Top Selling Products" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <ListView ItemsSource="{x:Bind ViewModel.BestSellingProducts, Mode=OneWay}" 
                                 SelectionMode="None" MaxHeight="300">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <Border Grid.Column="0" Background="{ThemeResource AccentFillColorDefaultBrush}" 
                                               Width="40" Height="40" CornerRadius="8" Margin="0,0,12,0">
                                            <FontIcon Glyph="&#xE7B8;" FontSize="16" Foreground="White"/>
                                        </Border>
                                        
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Category}" FontSize="12" 
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,24,0">
                                            <TextBlock Text="{Binding SoldCount}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="sold" FontSize="11" 
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                        
                                        <ProgressBar Grid.Column="3" Width="100" Value="{Binding SoldPercentage}" 
                                                    Maximum="100" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Revenue Chart Placeholder -->
            <Border Style="{StaticResource StatCardStyle}">
                <StackPanel>
                    <!-- Header with Month/Year Picker -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE9D9;" FontSize="24" Foreground="{ThemeResource SystemAccentColor}"/>
                            <StackPanel>
                                    <TextBlock Text="Revenue by day" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                    <Run Text="In "/>
                                    <Run Text="{x:Bind ViewModel.SelectedMonth, Mode=OneWay}"/>
                                    <Run Text="/"/>
                                    <Run Text="{x:Bind ViewModel.SelectedYear, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                        
                        <!-- Month/Year Picker -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE787;" FontSize="16" 
                                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                     VerticalAlignment="Center"/>
                            
                            <ComboBox x:Name="MonthComboBox"
                                     PlaceholderText="Month"
                                     SelectionChanged="MonthComboBox_SelectionChanged"
                                     Width="120"
                                     MinWidth="120">
                                <ComboBoxItem Content="January" Tag="1"/>
                                <ComboBoxItem Content="February" Tag="2"/>
                                <ComboBoxItem Content="March" Tag="3"/>
                                <ComboBoxItem Content="April" Tag="4"/>
                                <ComboBoxItem Content="May" Tag="5"/>
                                <ComboBoxItem Content="June" Tag="6"/>
                                <ComboBoxItem Content="July" Tag="7"/>
                                <ComboBoxItem Content="August" Tag="8"/>
                                <ComboBoxItem Content="September" Tag="9"/>
                                <ComboBoxItem Content="Octorber" Tag="10"/>
                                <ComboBoxItem Content="November" Tag="11"/>
                                <ComboBoxItem Content="December" Tag="12"/>
                            </ComboBox>
                            
                            <ComboBox x:Name="YearComboBox"
                                     PlaceholderText="Năm"
                                     SelectionChanged="YearComboBox_SelectionChanged"
                                     Width="100"
                                     MinWidth="100">
                                <!-- Years will be populated in code-behind -->
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    
                    <!-- Chart Container -->
                    <Grid Height="320" Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Chart Canvas -->
                        <Border Grid.Row="0" Background="{ThemeResource LayerFillColorDefaultBrush}" 
                               CornerRadius="8" Padding="16">
                            <Grid>
                                <Canvas x:Name="RevenueChartCanvas"
                                       PointerMoved="RevenueChartCanvas_PointerMoved"
                                       PointerExited="RevenueChartCanvas_PointerExited">
                                    <Canvas.Resources>
                                        <Storyboard x:Name="ChartAnimationStoryboard"/>
                                    </Canvas.Resources>
                                </Canvas>
                                
                                <!-- Tooltip Popup -->
                                <Popup x:Name="ChartTooltipPopup"
                                      IsLightDismissEnabled="False">
                                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                           BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                           BorderThickness="1"
                                           CornerRadius="8"
                                           Padding="12"
                                           MaxWidth="250">
                                        <Border.Shadow>
                                            <ThemeShadow/>
                                        </Border.Shadow>
                                        <StackPanel Spacing="8">
                                            <TextBlock x:Name="TooltipDate" 
                                                      FontWeight="SemiBold" 
                                                      FontSize="14"/>
                                            <StackPanel Spacing="4">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Border Width="12" Height="12" Background="#3B82F6" CornerRadius="2"/>
                                                        <TextBlock Text="Revenue:" FontSize="12" 
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    <TextBlock x:Name="TooltipRevenue" 
                                                              FontSize="12" 
                                                              FontWeight="SemiBold"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Border Width="12" Height="12" Background="#10B981" CornerRadius="2"/>
                                                        <TextBlock Text="Order:" FontSize="12" 
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    <TextBlock x:Name="TooltipOrders" 
                                                              FontSize="12" 
                                                              FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        
                        <!-- Legend -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" 
                                   Spacing="24" Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Width="16" Height="16" Background="#3B82F6" CornerRadius="4"/>
                                <TextBlock Text="Revenue" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Width="16" Height="16" Background="#10B981" CornerRadius="4"/>
                                <TextBlock Text="Order" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    
                    <!-- Stats Summary -->
                    <Grid Margin="0,16,0,0" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}" 
                               Padding="12" CornerRadius="8">
                            <StackPanel>
                                    <TextBlock Text="Total revenue" FontSize="11" 
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0">
                                    <Run Text="{x:Bind ViewModel.MonthlyRevenueData, Mode=OneWay, Converter={StaticResource MonthlyTotalRevenueConverter}}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        
                        <Border Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" 
                               Padding="12" CornerRadius="8">
                            <StackPanel>
                                    <TextBlock Text="Total order" FontSize="11" 
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0">
                                    <Run Text="{x:Bind ViewModel.MonthlyRevenueData, Mode=OneWay, Converter={StaticResource MonthlyTotalOrdersConverter}}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        
                        <Border Grid.Column="2" Background="{ThemeResource LayerFillColorDefaultBrush}" 
                               Padding="12" CornerRadius="8">
                            <StackPanel>
                                    <TextBlock Text="Average daily revenue" FontSize="11" 
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0">
                                    <Run Text="{x:Bind ViewModel.MonthlyRevenueData, Mode=OneWay, Converter={StaticResource MonthlyAvgRevenueConverter}}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>

        <!-- Loading Overlay -->
        <Grid x:Name="LoadingOverlay" 
              Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              Opacity="0.8">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <ProgressRing IsActive="True" Width="60" Height="60"/>
                <TextBlock Text="Đang tải dữ liệu..." 
                          FontSize="16" 
                          FontWeight="SemiBold"
                          Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                          HorizontalAlignment="Center"/>
                <TextBlock Text="Vui lòng đợi..." 
                          FontSize="14"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>