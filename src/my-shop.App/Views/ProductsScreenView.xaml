<Page
x:Class="my_shop.App.Views.ProductsScreenView"
x:Name="ProductsPage"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:local="using:my_shop.App.Views"
xmlns:vm="using:my_shop.App.ViewModels"
xmlns:models="using:my_shop.App.Models"
xmlns:converters="using:my_shop.App.Converters"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
mc:Ignorable="d"
Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
Loaded="Page_Loaded">

    <Page.Resources>
        <converters:CurrencyConverter x:Key="CurrencyConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVisibilityConverter"/>
        <converters:InvertedBoolConverter x:Key="InvertedBoolConverter"/>
        <converters:BoolToStringConverter x:Key="BoolToStringConverter"/>
        <converters:BoolToBrushConverter x:Key="BoolToBrushConverter"/>
        <converters:ImageListToFirstImageConverter x:Key="ImageListToFirstImageConverter"/>
        <converters:StockStatusConverter x:Key="StockStatusConverter"/>
        <converters:StockStatusColorConverter x:Key="StockStatusColorConverter"/>
        <converters:IntToBoolConverter x:Key="IntToBoolConverter"/>
        <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <converters:StringToInfoBarSeverityConverter x:Key="StringToInfoBarSeverityConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="24,24,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Quản lý sản phẩm" FontSize="32" FontWeight="Bold"/>
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                    <Run Text="{x:Bind ViewModel.IsManagementMode, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>

            <!-- Cart Icon Button (Sales Mode Only) -->
            <Button Grid.Column="1"
                   x:Name="CartButton"
                   Margin="0,0,12,0"
                   VerticalAlignment="Center"
                   Visibility="{Binding DataContext.IsManagementMode, ElementName=ProductsPage, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                <Button.Flyout>
                    <Flyout x:Name="CartFlyout" Placement="BottomEdgeAlignedRight">
                        <Grid Width="420" MaxHeight="600">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Cart Header -->
                            <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,16">
                                <TextBlock Text="Giỏ hàng" FontSize="24" FontWeight="Bold"/>
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                    <Run Text="{x:Bind ViewModel.CartTotalQuantity, Mode=OneWay}"/>
                                    <Run Text="sản phẩm"/>
                                </TextBlock>
                            </StackPanel>

                            <!-- Customer Selection -->
                            <StackPanel Grid.Row="1" Spacing="12" Margin="0,0,0,16">
                                <TextBlock Text="Thông tin khách hàng" FontWeight="SemiBold" FontSize="16"/>
                                
                                <!-- Toggle: Existing vs New Customer -->
                                <RadioButtons x:Name="CustomerTypeRadio" SelectedIndex="0" SelectionChanged="CustomerTypeRadio_SelectionChanged">
                                    <RadioButton Content="Khách hàng cũ" Tag="existing"/>
                                    <RadioButton Content="Khách hàng mới" Tag="new"/>
                                </RadioButtons>

                                <!-- Existing Customer Selection -->
                                <ComboBox x:Name="CustomerComboBox"
                                         ItemsSource="{x:Bind ViewModel.Customers, Mode=OneWay}"
                                         SelectedItem="{x:Bind ViewModel.SelectedCustomer, Mode=TwoWay}"
                                         DisplayMemberPath="DisplayText"
                                         PlaceholderText="Chọn khách hàng"
                                         HorizontalAlignment="Stretch"/>

                                <!-- New Customer Form -->
                                <StackPanel x:Name="NewCustomerPanel" Spacing="8" Visibility="Collapsed">
                                    <TextBox PlaceholderText="Tên khách hàng"
                                            Text="{x:Bind ViewModel.CustomerName, Mode=TwoWay}"/>
                                    <TextBox PlaceholderText="Số điện thoại"
                                            Text="{x:Bind ViewModel.CustomerPhone, Mode=TwoWay}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Cart Items -->
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.CartItems, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:CartItemModel">
                                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                   CornerRadius="8"
                                                   Padding="12"
                                                   Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Product Info -->
                                                    <Grid Grid.Row="0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="50"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Thumbnail -->
                                                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="4" Background="Gray">
                                                            <Image Source="{x:Bind ImageUrl}" Stretch="UniformToFill"/>
                                                        </Border>

                                                        <!-- Name & Price -->
                                                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind ProductName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{x:Bind Price, Converter={StaticResource CurrencyConverter}}" 
                                                                      FontSize="12" 
                                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                        </StackPanel>

                                                        <!-- Remove Button -->
                                                        <Button Grid.Column="2"
                                                               Click="RemoveFromCartButton_Click"
                                                               Style="{StaticResource SubtleButtonStyle}">
                                                            <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                                                        </Button>
                                                    </Grid>

                                                    <!-- Quantity Controls -->
                                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                                        <Button Click="DecreaseQuantityButton_Click"
                                                               Width="32"
                                                               Height="32">
                                                            <FontIcon Glyph="&#xE738;" FontSize="12"/>
                                                        </Button>

                                                        <TextBlock Text="{x:Bind Quantity, Mode=OneWay}"
                                                                  VerticalAlignment="Center"
                                                                  MinWidth="40"
                                                                  TextAlignment="Center"
                                                                  FontWeight="SemiBold"/>

                                                        <Button Click="IncreaseQuantityButton_Click"
                                                               Width="32"
                                                               Height="32">
                                                            <FontIcon Glyph="&#xE710;" FontSize="12"/>
                                                        </Button>

                                                        <TextBlock Text="{x:Bind Subtotal, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"
                                                                  VerticalAlignment="Center"
                                                                  Margin="12,0,0,0"
                                                                  FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Cart Summary -->
                            <StackPanel Grid.Row="3" Spacing="12" Margin="0,16,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                                <!-- Voucher Input -->
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Mã giảm giá" FontWeight="SemiBold" FontSize="13"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox Grid.Column="0"
                                                Text="{x:Bind ViewModel.VoucherCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                PlaceholderText="Nhập mã voucher"
                                                CharacterCasing="Upper"
                                                IsEnabled="{x:Bind ViewModel.HasVoucherApplied, Mode=OneWay, Converter={StaticResource InvertedBoolConverter}}"
                                                Margin="0,0,8,0"/>

                                        <Button Grid.Column="1"
                                               Command="{x:Bind ViewModel.ApplyVoucherCommand}"
                                               Style="{ThemeResource AccentButtonStyle}"
                                               Visibility="{x:Bind ViewModel.HasVoucherApplied, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                                            <TextBlock Text="Áp dụng"/>
                                        </Button>

                                        <Button Grid.Column="1"
                                               Command="{x:Bind ViewModel.RemoveVoucherCommand}"
                                               Visibility="{x:Bind ViewModel.HasVoucherApplied, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="Hủy"/>
                                        </Button>
                                    </Grid>

                                    <!-- Voucher Message -->
                                    <TextBlock Text="{x:Bind ViewModel.VoucherMessage, Mode=OneWay}"
                                              FontSize="12"
                                              Foreground="{x:Bind ViewModel.HasVoucherError, Mode=OneWay, Converter={StaticResource BoolToBrushConverter}, ConverterParameter='#FF4444|#4CAF50'}"
                                              Visibility="{x:Bind ViewModel.VoucherMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}"
                                              TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- Price Breakdown -->
                                <StackPanel Spacing="8">
                                    <Grid Visibility="{x:Bind ViewModel.HasVoucherApplied, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="Tạm tính" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{x:Bind ViewModel.CartOriginalPrice, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"
                                                  HorizontalAlignment="Right"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Grid>

                                    <Grid Visibility="{x:Bind ViewModel.HasVoucherApplied, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="Giảm giá" Foreground="#4CAF50" FontWeight="SemiBold"/>
                                        <TextBlock HorizontalAlignment="Right" Foreground="#4CAF50" FontWeight="SemiBold">
                                            <Run Text="-"/>
                                            <Run Text="{x:Bind ViewModel.CartDiscountAmount, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"/>
                                        </TextBlock>
                                    </Grid>

                                    <Grid>
                                        <TextBlock Text="Tổng cộng" FontWeight="SemiBold"/>
                                        <TextBlock Text="{x:Bind ViewModel.CartTotalPrice, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"
                                                  FontWeight="Bold"
                                                  FontSize="18"
                                                  HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>

                            <!-- Action Buttons -->
                            <StackPanel Grid.Row="4" Spacing="8" Margin="0,16,0,0">
                                <Button Click="CreateOrderButton_Click"
                                       HorizontalAlignment="Stretch"
                                       Style="{StaticResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE73E;" FontSize="16"/>
                                        <TextBlock Text="Tạo đơn hàng"/>
                                    </StackPanel>
                                </Button>

                                <Button Command="{x:Bind ViewModel.ClearCartCommand}"
                                       HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE74D;" FontSize="16"/>
                                        <TextBlock Text="Xóa giỏ hàng"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Flyout>
                </Button.Flyout>
                
                <Grid>
                    <FontIcon Glyph="&#xE7BF;" FontSize="24"/>
                    <!-- Badge -->
                    <Border Background="Red"
                           CornerRadius="10"
                           Padding="4,2"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Top"
                           Margin="0,-8,-8,0"
                           Visibility="{x:Bind ViewModel.HasCartItems, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{x:Bind ViewModel.CartTotalQuantity, Mode=OneWay}"
                                  FontSize="10"
                                  Foreground="White"
                                  FontWeight="Bold"/>
                    </Border>
                </Grid>
            </Button>

            <Button Grid.Column="2"
                   x:Name="ToggleModeButton"
                   Click="ToggleModeButton_Click"
                   VerticalAlignment="Center"
                   Width="230">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon x:Name="ToggleModeIcon" Glyph="&#xE7BF;"/>
                    <TextBlock x:Name="ToggleModeText" Text="Chuyển sang bán hàng"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1" Padding="24,0,24,24">

            <!-- Products Area -->
            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Search and Filter Bar -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Basic Search Row -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                PlaceholderText="Tìm kiếm sản phẩm (tên, SKU)..."
                                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Margin="0,0,8,0">
                            <TextBox.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Enter" Invoked="SearchBox_KeyboardAcceleratorInvoked"/>
                            </TextBox.KeyboardAccelerators>
                        </TextBox>

                        <Button Grid.Column="1"
                               Command="{x:Bind ViewModel.SearchProductsCommand}"
                               Margin="0,0,8,0"
                               Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE721;" FontSize="16"/>
                                <TextBlock Text="Tìm kiếm"/>
                            </StackPanel>
                        </Button>

                        <ComboBox Grid.Column="2"
                                 ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}"
                                 SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}"
                                 DisplayMemberPath="Name"
                                 PlaceholderText="Danh mục"
                                 HorizontalAlignment="Stretch"
                                 Margin="0,0,8,0"/>

                        <!-- Advanced Search Toggle -->
                        <Button Grid.Column="3"
                               Command="{x:Bind ViewModel.ToggleSearchCommand}"
                               Margin="0,0,8,0"
                               ToolTipService.ToolTip="Tìm kiếm nâng cao">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE71C;" FontSize="16"/>
                                <TextBlock Text="Nâng cao"/>
                                <FontIcon Glyph="{x:Bind ViewModel.IsSearchExpanded, Mode=OneWay, Converter={StaticResource BoolToStringConverter}, ConverterParameter='&#xE70D;|&#xE70E;'}" 
                                         FontSize="12"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="4"
                               x:Name="AddNewProductButton"
                               Click="AddNewButton_Click"
                               Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="16"/>
                                <TextBlock Text="Thêm mới"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Advanced Search Panel -->
                    <Border Grid.Row="1" 
                           Margin="0,12,0,0"
                           Background="{ThemeResource LayerFillColorDefaultBrush}"
                           BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                           BorderThickness="1"
                           CornerRadius="8"
                           Padding="16"
                           Visibility="{x:Bind ViewModel.IsSearchExpanded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <TextBlock Grid.Row="0" 
                                      Text="Bộ lọc nâng cao"
                                      FontWeight="SemiBold"
                                      Margin="0,0,0,12"/>

                            <!-- Filters Grid -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Price Range -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="8">
                                    <TextBlock Text="Giá từ" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <NumberBox Value="{x:Bind ViewModel.SearchMinPrice, Mode=TwoWay}"
                                              PlaceholderText="Giá tối thiểu"
                                              SpinButtonPlacementMode="Compact"
                                              Minimum="0"/>
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="2" Spacing="8">
                                    <TextBlock Text="Giá đến" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <NumberBox Value="{x:Bind ViewModel.SearchMaxPrice, Mode=TwoWay}"
                                              PlaceholderText="Giá tối đa"
                                              SpinButtonPlacementMode="Compact"
                                              Minimum="0"/>
                                </StackPanel>

                                <!-- Stock Range -->
                                <StackPanel Grid.Row="2" Grid.Column="0" Spacing="8">
                                    <TextBlock Text="Tồn kho từ" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <NumberBox Value="{x:Bind ViewModel.SearchMinStock, Mode=TwoWay}"
                                              PlaceholderText="Tồn tối thiểu"
                                              SpinButtonPlacementMode="Compact"
                                              Minimum="0"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="2" Spacing="8">
                                    <TextBlock Text="Tồn kho đến" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <NumberBox Value="{x:Bind ViewModel.SearchMaxStock, Mode=TwoWay}"
                                              PlaceholderText="Tồn tối đa"
                                              SpinButtonPlacementMode="Compact"
                                              Minimum="0"/>
                                </StackPanel>

                                <!-- Sort Options -->
                                <StackPanel Grid.Row="0" Grid.Column="4" Grid.RowSpan="3" Spacing="8">
                                    <TextBlock Text="Sắp xếp theo" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <ComboBox x:Name="SortByComboBox"
                                             HorizontalAlignment="Stretch"
                                             SelectionChanged="SortByComboBox_SelectionChanged">
                                        <ComboBoxItem Content="Tên sản phẩm" Tag="name" IsSelected="True"/>
                                        <ComboBoxItem Content="Giá" Tag="price"/>
                                        <ComboBoxItem Content="Tồn kho" Tag="stock"/>
                                    </ComboBox>

                                    <TextBlock Text="Thứ tự" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,8,0,0"/>
                                    <ComboBox x:Name="SortOrderComboBox"
                                             HorizontalAlignment="Stretch"
                                             SelectionChanged="SortOrderComboBox_SelectionChanged">
                                        <ComboBoxItem Content="Tăng dần" Tag="asc" IsSelected="True"/>
                                        <ComboBoxItem Content="Giảm dần" Tag="desc"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <!-- Action Buttons -->
                            <StackPanel Grid.Row="2" 
                                       Orientation="Horizontal" 
                                       Spacing="8" 
                                       Margin="0,16,0,0"
                                       HorizontalAlignment="Right">
                                <Button Command="{x:Bind ViewModel.SearchProductsCommand}"
                                       Style="{StaticResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE721;" FontSize="14"/>
                                        <TextBlock Text="Áp dụng"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{x:Bind ViewModel.ClearSearchCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE894;" FontSize="14"/>
                                        <TextBlock Text="Xóa bộ lọc"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Products Grid with Pagination -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <ScrollViewer Grid.Row="0">
                        <GridView ItemsSource="{x:Bind ViewModel.Products, Mode=OneWay}"
                                 SelectionMode="None"
                                 IsItemClickEnabled="False"
                                 Padding="0">
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="models:ProductModel">
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                           BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                           BorderThickness="1"
                                           CornerRadius="8"
                                           Width="280"
                                           Height="380"
                                           Padding="16">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="160"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Product Image -->
                                            <Border Grid.Row="0"
                                                   CornerRadius="4"
                                                   Background="{ThemeResource LayerFillColorDefaultBrush}">
                                                <Grid>
                                                    <!-- Default placeholder when no image -->
                                                    <FontIcon Glyph="&#xE91B;" 
                                                             FontSize="48" 
                                                             Foreground="#999999"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>
                                                    <!-- Actual image if available -->
                                                    <Image Stretch="UniformToFill">
                                                        <Image.Source>
                                                            <BitmapImage UriSource="{x:Bind Images, Converter={StaticResource ImageListToFirstImageConverter}, Mode=OneWay}" />
                                                        </Image.Source>
                                                    </Image>
                                                </Grid>
                                            </Border>

                                            <!-- Product Info -->
                                            <StackPanel Grid.Row="1" Spacing="8" Margin="0,12,0,0">
                                                <TextBlock Text="{x:Bind Name}"
                                                          FontWeight="SemiBold"
                                                          FontSize="16"
                                                          TextTrimming="CharacterEllipsis"
                                                          MaxLines="2"/>
                                                
                                                <TextBlock Text="{x:Bind Sku}"
                                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                          FontSize="12"/>

                                                <TextBlock FontSize="14" FontWeight="SemiBold">
                                                    <Run Text="Price: "/>
                                                    <Run Text="{x:Bind ImportPrice}"/>
                                                </TextBlock>

                                                <TextBlock FontSize="12">
                                                    <Run Text="Stock: "/>
                                                    <Run Text="{x:Bind Count}"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- Action Buttons - Show based on IsManagementMode -->
                                            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                                                <Button Width="130"
                                                       Click="EditButton_Click"
                                                       CommandParameter="{x:Bind}"
                                                       Visibility="{Binding DataContext.IsManagementMode, ElementName=ProductsPage, Converter={StaticResource BoolToVisibilityConverter}}"
                                                       Style="{StaticResource AccentButtonStyle}">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <FontIcon Glyph="&#xE70F;" FontSize="14"/>
                                                        <TextBlock Text="Sửa"/>
                                                    </StackPanel>
                                                </Button>

                                                <Button Width="130"
                                                       Click="DeleteButton_Click"
                                                       CommandParameter="{x:Bind}"
                                                       Visibility="{Binding DataContext.IsManagementMode, ElementName=ProductsPage, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                                                        <TextBlock Text="Xóa"/>
                                                    </StackPanel>
                                                </Button>
                                                
                                                <!-- Sales Mode: Add to Cart Button -->
                                                <Button Width="270"
                                                       Command="{Binding DataContext.AddToCartCommand, ElementName=ProductsPage}"
                                                       CommandParameter="{x:Bind}"
                                                       Visibility="{Binding DataContext.IsManagementMode, ElementName=ProductsPage, Converter={StaticResource InvertedBoolToVisibilityConverter}}"
                                                       Style="{StaticResource AccentButtonStyle}">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <FontIcon Glyph="&#xE7BF;" FontSize="14"/>
                                                        <TextBlock Text="Thêm vào giỏ"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </ScrollViewer>

                    <!-- Pagination Controls -->
                    <Grid Grid.Row="1" 
                          Margin="0,16,0,0"
                          Padding="16"
                          Background="{ThemeResource LayerFillColorDefaultBrush}"
                          CornerRadius="8"
                          Visibility="{x:Bind ViewModel.TotalPages, Mode=OneWay, Converter={StaticResource IntToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Previous Button -->
                        <Button Grid.Column="0"
                               Command="{x:Bind ViewModel.PreviousPageCommand}"
                               IsEnabled="{x:Bind ViewModel.CurrentPage, Mode=OneWay, Converter={StaticResource IntToBoolConverter}}"
                               Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE76B;" FontSize="14"/>
                                <TextBlock Text="Trang trước"/>
                            </StackPanel>
                        </Button>

                        <!-- Page Info -->
                        <StackPanel Grid.Column="1" 
                                   Orientation="Horizontal" 
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Spacing="8">
                            <TextBlock Text="Trang" 
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind ViewModel.CurrentPage, Mode=OneWay}" 
                                      FontWeight="SemiBold"
                                      VerticalAlignment="Center"/>
                            <TextBlock Text="/" 
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind ViewModel.TotalPages, Mode=OneWay}" 
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="•" 
                                      VerticalAlignment="Center"
                                      Margin="8,0"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                <Run Text="Tổng:"/>
                                <Run Text="{x:Bind ViewModel.TotalProducts, Mode=OneWay}" FontWeight="SemiBold"/>
                                <Run Text="sản phẩm"/>
                            </TextBlock>
                        </StackPanel>

                        <!-- Next Button -->
                        <Button Grid.Column="2"
                               Command="{x:Bind ViewModel.NextPageCommand}"
                               Margin="16,0,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Trang sau"/>
                                <FontIcon Glyph="&#xE76C;" FontSize="14"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>

                <!-- Loading Indicator -->
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                             Width="50"
                             Height="50"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
            </Grid>
        </Grid>

        <!-- Error Message - TEMPORARILY DISABLED FOR DEBUGGING -->
        <!--
        <InfoBar Grid.Row="1"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Severity="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToInfoBarSeverityConverter}}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                VerticalAlignment="Bottom"
                Margin="24"/>
        -->
    </Grid>
</Page>