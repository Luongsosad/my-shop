<Page
    x:Class="my_shop.App.Views.SettingsScreenView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:my_shop.App.Views"
    xmlns:vm="using:my_shop.App.ViewModels"
    xmlns:converters="using:my_shop.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- License Converters -->
        <converters:BoolToLicenseIconConverter x:Key="BoolToLicenseIconConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>

        <!-- Settings Converters -->
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:ThemeConverter x:Key="ThemeConverter"/>
        <converters:StringToBoolConverter x:Key="StringToBoolConverter"/>

        <Style x:Key="SettingsSectionStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
        </Style>

        <!-- Expander Style -->
        <Style TargetType="Expander">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
    </Page.Resources>

    <Grid Padding="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock Text="Settings" 
                       FontSize="32" 
                       FontWeight="SemiBold"/>
            <TextBlock Text="Manage application licenses, information, and preferences" 
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       FontSize="14"/>
        </StackPanel>

        <!-- Content -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="8" Width="800" HorizontalAlignment="Center">

                <!-- ===== 1. LICENSE & ACTIVATION EXPANDER ===== -->
                <Expander IsExpanded="True">
                    <Expander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE72E;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                <TextBlock Text="License and Activation" FontSize="15" FontWeight="SemiBold"/>
                            </StackPanel>

                            <!-- Status Badge -->
                            <Border Grid.Column="2"
                                    Background="{ThemeResource SystemFillColorSuccessBrush}"
                                    CornerRadius="12"
                                    Padding="12,6"
                                    Margin="0,0,12,0"
                                    Visibility="{x:Bind ViewModel.IsActivated, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="White"/>
                                    <TextBlock Text="Activated" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                                </StackPanel>
                            </Border>

                            <!-- Trial Badge -->
                            <Border Grid.Column="2"
                                    Background="{ThemeResource SystemFillColorCautionBrush}"
                                    CornerRadius="12"
                                    Padding="12,6"
                                    Margin="0,0,12,0"
                                    Visibility="{x:Bind ViewModel.IsInTrial, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE916;" FontSize="12" Foreground="White"/>
                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="White">
                                        <Run Text="{x:Bind ViewModel.DaysRemaining, Mode=OneWay}"/>
                                        <Run Text="days left"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Expander.Header>

                    <Expander.Content>
                        <StackPanel Spacing="16" Margin="0,16,0,0">

                            <!-- License Status -->
                            <Border Style="{StaticResource SettingsSectionStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="64" Height="64" CornerRadius="32" VerticalAlignment="Top">
                                        <Border.Background>
                                            <SolidColorBrush Color="{ThemeResource SystemAccentColor}" Opacity="0.1"/>
                                        </Border.Background>
                                        <FontIcon Glyph="{x:Bind ViewModel.IsActivated, Mode=OneWay, Converter={StaticResource BoolToLicenseIconConverter}}"
                                                  FontSize="32"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.LicenseStatus, Mode=OneWay}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"/>

                                        <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsInTrial, Mode=OneWay}">
                                            <ProgressBar Value="{x:Bind ViewModel.DaysRemaining, Mode=OneWay}"
                                                         Maximum="14"
                                                         Height="4"
                                                         CornerRadius="2"/>
                                            <TextBlock FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                <Run Text="Trial expires in"/>
                                                <Run Text="{x:Bind ViewModel.DaysRemaining, Mode=OneWay}" FontWeight="SemiBold"/>
                                                <Run Text="days"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Activation Form -->
                            <Border Style="{StaticResource SettingsSectionStyle}"
                                    Visibility="{x:Bind ViewModel.IsActivated, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="Enter your activation code to unlock all features permanently"
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               FontSize="13"/>

                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Activation Code" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBox Text="{x:Bind ViewModel.ActivationCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="XXXXX-XXXXX-XXXXX-XXXXX"
                                                 FontFamily="Consolas"
                                                 FontSize="14"
                                                 MaxLength="23"/>
                                    </StackPanel>

                                    <Button Command="{x:Bind ViewModel.ActivateSoftwareCommand}"
                                            Style="{StaticResource AccentButtonStyle}"
                                            HorizontalAlignment="Right">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE73E;" FontSize="16"/>
                                            <TextBlock Text="Activate Now"/>
                                        </StackPanel>
                                    </Button>

                                    <InfoBar Severity="Informational"
                                             IsOpen="True"
                                             IsClosable="False"
                                             Title="Need an activation code?"
                                             Message="Contact support or use the generator below for testing purposes"/>

                                    <Button Command="{x:Bind ViewModel.GenerateAndSendCodeCommand}"
                                            Content="Generate Code"
                                            Width="132"
                                            HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Border>

                            <!-- What's Included -->
                            <Border Style="{StaticResource SettingsSectionStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="What's Included" FontSize="16" FontWeight="SemiBold"/>

                                    <ItemsControl>
                                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4">
                                            <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                                            <TextBlock Text="Full access to order printing (PDF invoices)" FontSize="13"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4">
                                            <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                                            <TextBlock Text="Unlimited orders and products" FontSize="13"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4">
                                            <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                                            <TextBlock Text="No trial restrictions" FontSize="13"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4">
                                            <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                                            <TextBlock Text="Lifetime updates" FontSize="13"/>
                                        </StackPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Expander.Content>
                </Expander>

                <!-- ===== 2. THEME SETTINGS EXPANDER ===== -->
                <Expander>
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE771;" FontSize="15" Foreground="{ThemeResource SystemAccentColor}"/>
                            <TextBlock Text="Display (Theme)" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Expander.Header>

                    <Expander.Content>
                        <Border Style="{StaticResource SettingsSectionStyle}" Margin="0,16,0,0">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Choose theme for your application" 
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          FontSize="13"/>

                                <StackPanel Spacing="8">
                                    <RadioButton Content="Light" FontWeight="Medium"
                                               GroupName="ThemeGroup"
                                               IsChecked="{x:Bind ViewModel.SelectedTheme, Mode=OneWay, Converter={StaticResource ThemeConverter}, ConverterParameter=Light}"
                                               Click="ThemeRadioButton_Click"
                                               Tag="Light"/>
                                    <RadioButton Content="Dark" FontWeight="Medium"
                                               GroupName="ThemeGroup"
                                               IsChecked="{x:Bind ViewModel.SelectedTheme, Mode=OneWay, Converter={StaticResource ThemeConverter}, ConverterParameter=Dark}"
                                               Click="ThemeRadioButton_Click"
                                               Tag="Dark"/>
                                    <RadioButton Content="Default (System)" FontWeight="Medium"
                                               GroupName="ThemeGroup"
                                               IsChecked="{x:Bind ViewModel.SelectedTheme, Mode=OneWay, Converter={StaticResource ThemeConverter}, ConverterParameter=System}"
                                               Click="ThemeRadioButton_Click"
                                               Tag="System"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Expander.Content>
                </Expander>

                <!-- ===== 3. STORE INFORMATION EXPANDER ===== -->
                <Expander>
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE8D4;" FontSize="15" Foreground="#10B981"/>
                            <TextBlock Text="Store Information" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Expander.Header>

                    <Expander.Content>
                        <Border Style="{StaticResource SettingsSectionStyle}" Margin="0,16,0,0">
                            <StackPanel Spacing="16">
                                <TextBlock Text="Information displayed on invoices and reports." 
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          FontSize="13"/>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="Store Name" FontWeight="SemiBold"/>
                                    <TextBox FontSize="13"
                                            Text="{x:Bind ViewModel.StoreInfo.StoreName, Mode=TwoWay}"
                                            PlaceholderText="Enter store name"/>
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="Address" FontWeight="SemiBold"/>
                                    <TextBox FontSize="13"
                                            Text="{x:Bind ViewModel.StoreInfo.Address, Mode=TwoWay}"
                                            PlaceholderText="Enter store address"/>
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="Phone Number" FontWeight="SemiBold"/>
                                    <TextBox FontSize="13"
                                            Text="{x:Bind ViewModel.StoreInfo.Phone, Mode=TwoWay}"
                                            PlaceholderText="Enter phone number"/>
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="Email Address" FontWeight="SemiBold"/>
                                    <TextBox FontSize="13"
                                            Text="{x:Bind ViewModel.StoreInfo.Email, Mode=TwoWay}"
                                            PlaceholderText="Enter email address"/>
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="Tax Code" FontWeight="SemiBold"/>
                                    <TextBox FontSize="13"
                                            Text="{x:Bind ViewModel.StoreInfo.TaxCode, Mode=TwoWay}"
                                            PlaceholderText="Enter tax code"/>
                                </StackPanel>

                                <Button Command="{x:Bind ViewModel.SaveStoreInfoCommand}"
        Style="{StaticResource AccentButtonStyle}"
        HorizontalAlignment="Right"
        Margin="0,8,0,0">

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE77B;" FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock Text="Save Changes" FontWeight="SemiBold"/>
                                    </StackPanel>

                                </Button>

                            </StackPanel>
                        </Border>
                    </Expander.Content>
                </Expander>

                <!-- ===== 4. USER PROFILE EXPANDER ===== -->
                <Expander>
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE77B;" FontSize="15" Foreground="#3B82F6"/>
                            <TextBlock Text="User Profile" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Expander.Header>

                    <Expander.Content>
                        <Border Style="{StaticResource SettingsSectionStyle}" Margin="0,16,0,0">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Full Name" FontWeight="SemiBold"/>
                                <TextBox FontSize="13"
                                        Text="{x:Bind ViewModel.UserProfile.Name, Mode=TwoWay}"
                                        PlaceholderText="Enter full name"/>

                                <TextBlock Text="Email" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                <TextBox Text="{x:Bind ViewModel.UserProfile.Email, Mode=OneWay}"
                                        IsReadOnly="True"
                                        IsEnabled="False"/>

                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Spacing="10">
                                    <TextBlock Text="Created date:" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{x:Bind ViewModel.UserProfile.CreatedAt, Mode=OneWay}" FontWeight="SemiBold"/>
                                </StackPanel>

                                <Button Command="{x:Bind ViewModel.SaveUserProfileCommand}"
                                       Style="{StaticResource AccentButtonStyle}"
                                       HorizontalAlignment="Right"
                                       Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE70F;" FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock Text="Update Profile" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Expander.Content>
                </Expander>

                <!-- ===== 5. CHANGE PASSWORD EXPANDER ===== -->
                <Expander>
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE72E;" FontSize="15" Foreground="#F59E0B"/>
                            <TextBlock Text="Change Password" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Expander.Header>

                    <Expander.Content>
                        <Border Style="{StaticResource SettingsSectionStyle}" Margin="0,16,0,0">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Ensure your account is secure by changing your password regularly." 
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          FontSize="13"/>

                                <TextBlock Text="Current Password" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                <PasswordBox x:Name="CurrentPasswordBox" PlaceholderText="Enter current password"/>

                                <TextBlock Text="New Password" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                <PasswordBox x:Name="NewPasswordBox" PlaceholderText="Enter new password (at least 6 characters)"/>

                                <TextBlock Text="Confirm New Password" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                <PasswordBox x:Name="ConfirmPasswordBox" PlaceholderText="Re-enter new password"/>

                                <Button Click="ChangePasswordButton_Click"
                                       Style="{StaticResource AccentButtonStyle}"
                                       HorizontalAlignment="Right"
                                       Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE70F;" FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock Text="Change Password" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Expander.Content>
                </Expander>

                <!-- ===== 6. HELP & SUPPORT EXPANDER ===== -->
                <Expander>
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE897;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Help and Support" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Expander.Header>

                    <Expander.Content>
                        <Border Style="{StaticResource SettingsSectionStyle}" Margin="0,16,0,0">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Need help getting started or want to review the features?"
                                          TextWrapping="Wrap"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          FontSize="13"/>

                                <Button Grid.Column="1" Command="{x:Bind ViewModel.ShowOnboardingTourCommand}"
                                       HorizontalAlignment="Right"
                                        Margin="0,30,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE897;" FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock Text="Show Help" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </Expander.Content>
                </Expander>

                <!-- ===== 7. ACCOUNT & LOGOUT EXPANDER ===== -->
                <Expander>
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xF3B1;" FontSize="15" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                            <TextBlock Text="Account" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Expander.Header>

                    <Expander.Content>
                        <Border Style="{StaticResource SettingsSectionStyle}" Margin="0,16,0,0">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="Version:" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.AppVersion, Mode=OneWay}" FontWeight="SemiBold"/>
                                </Grid>

                                <TextBlock Text="My Shop - Smart Store Management Application" FontWeight="SemiBold"/>

                                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4"/>

                                <Button Command="{x:Bind ViewModel.LogoutCommand}" HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xF3B1;" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock Text="Log Out" Foreground="White" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <Button.Resources>
                                        <SolidColorBrush x:Key="ButtonBackground" Color="#DC2626"/>
                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#B91C1C"/>
                                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#991B1B"/>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Expander.Content>
                </Expander>

            </StackPanel>
        </ScrollViewer>

        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="3"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              Opacity="0.8"
              Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <ProgressRing IsActive="True" Width="48" Height="48"/>
        </Grid>

        <!-- Floating Notifications -->
        <StackPanel Grid.Row="2" 
                    Spacing="8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,20,0,0">
            <InfoBar x:Name="ErrorInfoBar"
                    IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                    Severity="Error"
                    Title="Error"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    IsClosable="True"
                    MaxWidth="600"/>

            <InfoBar x:Name="SuccessInfoBar"
                    IsOpen="{x:Bind ViewModel.SuccessMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                    Severity="Success"
                    Title="Success"
                    Message="{x:Bind ViewModel.SuccessMessage, Mode=OneWay}"
                    IsClosable="True"
                    MaxWidth="600"/>
        </StackPanel>
    </Grid>
</Page>