<Page
    x:Class="my_shop.App.Views.SettingsScreenView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:my_shop.App.Views"
    xmlns:vm="using:my_shop.App.ViewModels"
    xmlns:converters="using:my_shop.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- License Converters -->
        <converters:BoolToLicenseIconConverter x:Key="BoolToLicenseIconConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        
        <!-- Settings Converters -->
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:ThemeConverter x:Key="ThemeConverter"/>
        <converters:StringToBoolConverter x:Key="StringToBoolConverter"/>
        
        <Style x:Key="SettingsSectionStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
    </Page.Resources>

    <Grid Padding="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock Text="Settings" 
                       FontSize="32" 
                       FontWeight="SemiBold"/>
            <TextBlock Text="Quản lý license, thông tin và tùy chọn ứng dụng" 
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       FontSize="14"/>
        </StackPanel>

        <!-- Content -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="24" Width="800" HorizontalAlignment="Center">

                <!-- ===== LICENSE SECTION ===== -->
                
                <!-- License Status Card -->
                <Border Style="{StaticResource SettingsSectionStyle}">
                    <StackPanel Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE72E;" 
                                      FontSize="24"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="License Status" 
                                       FontSize="20" 
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Border Height="1" 
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                        <!-- Status Display -->
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Status Icon -->
                            <Border Grid.Column="0"
                                    Width="64"
                                    Height="64"
                                    CornerRadius="32"
                                    VerticalAlignment="Top">
                                <Border.Background>
                                    <SolidColorBrush Color="{ThemeResource SystemAccentColor}" Opacity="0.1"/>
                                </Border.Background>
                                <FontIcon Glyph="{x:Bind ViewModel.IsActivated, Mode=OneWay, Converter={StaticResource BoolToLicenseIconConverter}}"
                                          FontSize="32"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            </Border>

                            <!-- Status Info -->
                            <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.LicenseStatus, Mode=OneWay}"
                                           FontSize="16"
                                           FontWeight="SemiBold"/>

                                <!-- Trial Info -->
                                <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsInTrial, Mode=OneWay}">
                                    <ProgressBar Value="{x:Bind ViewModel.DaysRemaining, Mode=OneWay}"
                                                 Maximum="14"
                                                 Height="4"
                                                 CornerRadius="2"/>
                                    <TextBlock FontSize="13"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                        <Run Text="Trial expires in"/>
                                        <Run Text="{x:Bind ViewModel.DaysRemaining, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <Run Text="days"/>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Activated Badge -->
                                <Border Background="{ThemeResource SystemFillColorSuccessBrush}"
                                        CornerRadius="12"
                                        Padding="12,6"
                                        HorizontalAlignment="Left"
                                        Visibility="{x:Bind ViewModel.IsActivated, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE73E;" 
                                                  FontSize="12"
                                                  Foreground="White"/>
                                        <TextBlock Text="Activated" 
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="White"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Activation Card -->
                <Border Style="{StaticResource SettingsSectionStyle}"
                        Visibility="{x:Bind ViewModel.IsActivated, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <StackPanel Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE8D7;" 
                                      FontSize="24"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Activate Software" 
                                       FontSize="20" 
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Border Height="1" 
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                        <TextBlock Text="Enter your activation code to unlock all features permanently"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="13"/>

                        <!-- Activation Code Input -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Activation Code" 
                                       FontSize="13"
                                       FontWeight="SemiBold"/>
                            <TextBox Text="{x:Bind ViewModel.ActivationCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="XXXXX-XXXXX-XXXXX-XXXXX"
                                     FontFamily="Consolas"
                                     FontSize="14"
                                     MaxLength="23"/>
                        </StackPanel>

                        <Button Command="{x:Bind ViewModel.ActivateSoftwareCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE73E;" FontSize="16"/>
                                <TextBlock Text="Activate Now"/>
                            </StackPanel>
                        </Button>

                        <!-- Info Panel -->
                        <InfoBar Severity="Informational"
                                 IsOpen="True"
                                 IsClosable="False"
                                 Title="Need an activation code?"
                                 Message="Contact support or use the generator below for testing purposes"/>

                        <Button Command="{x:Bind ViewModel.GenerateAndSendCodeCommand}"
                                Content="Generate Code"
                                Width="132"
                                HorizontalAlignment="Right"/>
                    </StackPanel>
                </Border>

                <!-- Features Info -->
                <Border Style="{StaticResource SettingsSectionStyle}">
                    <StackPanel Spacing="16">
                        <TextBlock Text="What's Included" 
                                   FontSize="18" 
                                   FontWeight="SemiBold"/>

                        <Border Height="1" 
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                        <ItemsControl>
                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4">
                                <FontIcon Glyph="&#xE73E;" 
                                          FontSize="16"
                                          Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                                <TextBlock Text="Full access to order printing (PDF invoices)" FontSize="13"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4">
                                <FontIcon Glyph="&#xE73E;" 
                                          FontSize="16"
                                          Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                                <TextBlock Text="Unlimited orders and products" FontSize="13"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4">
                                <FontIcon Glyph="&#xE73E;" 
                                          FontSize="16"
                                          Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                                <TextBlock Text="No trial restrictions" FontSize="13"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4">
                                <FontIcon Glyph="&#xE73E;" 
                                          FontSize="16"
                                          Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                                <TextBlock Text="Lifetime updates" FontSize="13"/>
                            </StackPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ===== SETTINGS SECTION ===== -->
                
                <!-- Theme Settings -->
                <Border Style="{StaticResource SettingsSectionStyle}">
                    <StackPanel Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE771;" FontSize="24" Foreground="{ThemeResource SystemAccentColor}"/>
                            <TextBlock Text="Giao diện" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="Chọn theme cho ứng dụng" 
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  FontSize="13"/>

                        <StackPanel Spacing="8">
                            <RadioButton Content="Sáng (Light)" 
                                       GroupName="ThemeGroup"
                                       IsChecked="{x:Bind ViewModel.SelectedTheme, Mode=OneWay, Converter={StaticResource ThemeConverter}, ConverterParameter=Light}"
                                       Click="ThemeRadioButton_Click"
                                       Tag="Light"/>
                            <RadioButton Content="Tối (Dark)" 
                                       GroupName="ThemeGroup"
                                       IsChecked="{x:Bind ViewModel.SelectedTheme, Mode=OneWay, Converter={StaticResource ThemeConverter}, ConverterParameter=Dark}"
                                       Click="ThemeRadioButton_Click"
                                       Tag="Dark"/>
                            <RadioButton Content="Theo hệ thống (System)" 
                                       GroupName="ThemeGroup"
                                       IsChecked="{x:Bind ViewModel.SelectedTheme, Mode=OneWay, Converter={StaticResource ThemeConverter}, ConverterParameter=System}"
                                       Click="ThemeRadioButton_Click"
                                       Tag="System"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Store Information -->
                <Border Style="{StaticResource SettingsSectionStyle}">
                    <StackPanel Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE8D4;" FontSize="24" Foreground="#10B981"/>
                            <TextBlock Text="Thông tin cửa hàng" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="Thông tin hiển thị trên hóa đơn và báo cáo" 
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  FontSize="13"/>

                        <StackPanel Spacing="12">
                            <TextBox Header="Tên cửa hàng"
                                    Text="{x:Bind ViewModel.StoreInfo.StoreName, Mode=TwoWay}"
                                    PlaceholderText="Nhập tên cửa hàng"/>
                            
                            <TextBox Header="Địa chỉ"
                                    Text="{x:Bind ViewModel.StoreInfo.Address, Mode=TwoWay}"
                                    PlaceholderText="Nhập địa chỉ"/>
                            
                            <TextBox Header="Số điện thoại"
                                    Text="{x:Bind ViewModel.StoreInfo.Phone, Mode=TwoWay}"
                                    PlaceholderText="Nhập số điện thoại"/>
                            
                            <TextBox Header="Email"
                                    Text="{x:Bind ViewModel.StoreInfo.Email, Mode=TwoWay}"
                                    PlaceholderText="Nhập email"/>
                            
                            <TextBox Header="Mã số thuế"
                                    Text="{x:Bind ViewModel.StoreInfo.TaxCode, Mode=TwoWay}"
                                    PlaceholderText="Nhập mã số thuế"/>

                            <Button Content="Lưu thông tin"
                                   Command="{x:Bind ViewModel.SaveStoreInfoCommand}"
                                   Style="{StaticResource AccentButtonStyle}"
                                   HorizontalAlignment="Right"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- User Profile -->
                <Border Style="{StaticResource SettingsSectionStyle}">
                    <StackPanel Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE77B;" FontSize="24" Foreground="#3B82F6"/>
                            <TextBlock Text="Hồ sơ người dùng" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Spacing="12">
                            <TextBox Header="Họ tên"
                                    Text="{x:Bind ViewModel.UserProfile.Name, Mode=TwoWay}"
                                    PlaceholderText="Nhập họ tên"/>
                            
                            <TextBox Header="Email"
                                    Text="{x:Bind ViewModel.UserProfile.Email, Mode=OneWay}"
                                    IsReadOnly="True"
                                    IsEnabled="False"/>
                            
                            <TextBlock Text="Ngày tạo tài khoản" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{x:Bind ViewModel.UserProfile.CreatedAt, Mode=OneWay}"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                            <Button Content="Cập nhật hồ sơ"
                                   Command="{x:Bind ViewModel.SaveUserProfileCommand}"
                                   Style="{StaticResource AccentButtonStyle}"
                                   HorizontalAlignment="Right"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Change Password -->
                <Border Style="{StaticResource SettingsSectionStyle}">
                    <StackPanel Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE72E;" FontSize="24" Foreground="#F59E0B"/>
                            <TextBlock Text="Đổi mật khẩu" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="Đảm bảo tài khoản của bạn an toàn bằng cách thay đổi mật khẩu định kỳ" 
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  FontSize="13"/>

                        <StackPanel Spacing="12">
                            <PasswordBox x:Name="CurrentPasswordBox"
                                        Header="Mật khẩu hiện tại"
                                        PlaceholderText="Nhập mật khẩu hiện tại"/>
                            
                            <PasswordBox x:Name="NewPasswordBox"
                                        Header="Mật khẩu mới"
                                        PlaceholderText="Nhập mật khẩu mới (tối thiểu 6 ký tự)"/>
                            
                            <PasswordBox x:Name="ConfirmPasswordBox"
                                        Header="Xác nhận mật khẩu mới"
                                        PlaceholderText="Nhập lại mật khẩu mới"/>

                            <Button Content="Đổi mật khẩu"
                                   Click="ChangePasswordButton_Click"
                                   Style="{StaticResource AccentButtonStyle}"
                                   HorizontalAlignment="Right"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Account & Logout -->
                <Border Style="{StaticResource SettingsSectionStyle}">
                    <StackPanel Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xF3B1;" 
                                FontSize="24"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                            <TextBlock 
                                Text="Tài khoản" 
                                FontSize="20" 
                                FontWeight="SemiBold"
                                VerticalAlignment="Center"/>
                        </StackPanel>

                        <Border Height="1" 
                            Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" 
                                      Text="Phiên bản:" 
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" 
                                      Text="{x:Bind ViewModel.AppVersion, Mode=OneWay}"
                                      FontWeight="SemiBold"/>
                        </Grid>

                        <TextBlock Text="My Shop - Quản lý cửa hàng thông minh" 
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <Border Height="1" 
                               Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                        <Button Content="Đăng xuất / Log Out"
                               Click="LogoutButton_Click"
                               HorizontalAlignment="Stretch">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackground" Color="#DC2626"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#B91C1C"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#991B1B"/>
                                <SolidColorBrush x:Key="ButtonForeground" Color="White"/>
                                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White"/>
                                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White"/>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="3"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              Opacity="0.8"
              Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <ProgressRing IsActive="True" Width="48" Height="48"/>
        </Grid>

        <!-- Floating Notifications -->
        <StackPanel Grid.Row="2" 
                    Spacing="8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,20,0,0">
            <InfoBar x:Name="ErrorInfoBar"
                    IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                    Severity="Error"
                    Title="Lỗi"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    IsClosable="True"
                    MaxWidth="600"/>

            <InfoBar x:Name="SuccessInfoBar"
                    IsOpen="{x:Bind ViewModel.SuccessMessage, Mode=OneWay, Converter={StaticResource StringToBoolConverter}}"
                    Severity="Success"
                    Title="Thành công"
                    Message="{x:Bind ViewModel.SuccessMessage, Mode=OneWay}"
                    IsClosable="True"
                    MaxWidth="600"/>
        </StackPanel>
    </Grid>
</Page>
