<Page
    x:Class="my_shop.App.Views.ReportScreenView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:my_shop.App.Views"
    xmlns:vm="using:my_shop.App.ViewModels"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    xmlns:converters="using:my_shop.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:BoolToArrowConverter x:Key="BoolToArrowConverter"/>
        <converters:StringToColorConverter x:Key="StringToColorConverter"/>
        <converters:BoolToGreenRedConverter x:Key="BoolToGreenRedConverter"/>
        <converters:DoubleToMarginStatusConverter x:Key="DoubleToMarginStatusConverter"/>
        <converters:DoubleToPercentageConverter x:Key="DoubleToPercentageConverter"/>
    </Page.Resources>

    <ScrollViewer>
        <Grid Padding="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header Section -->
            <StackPanel Grid.Row="0" Spacing="16" Margin="0,0,0,24">
                <TextBlock Text="Reports &amp; Analytics" 
                          FontSize="32" 
                          FontWeight="Bold"/>
                
                <TextBlock Text="View business insights and reports" 
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          FontSize="14"/>

                <!-- Filters -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                       BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                       BorderThickness="1"
                       CornerRadius="8"
                       Padding="16">
                    <StackPanel Spacing="16">
                        <!-- Quick Date Range Buttons -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Quick Ranges" FontSize="12" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Today" 
                                       Command="{x:Bind ViewModel.SetDateRangeCommand}" 
                                       CommandParameter="today"
                                       Style="{StaticResource AccentButtonStyle}"
                                       Height="32"
                                       Padding="12,0"/>
                                <Button Content="Yesterday" 
                                       Command="{x:Bind ViewModel.SetDateRangeCommand}" 
                                       CommandParameter="yesterday"
                                       Height="32"
                                       Padding="12,0"/>
                                <Button Content="Last 7 Days" 
                                       Command="{x:Bind ViewModel.SetDateRangeCommand}" 
                                       CommandParameter="last7days"
                                       Height="32"
                                       Padding="12,0"/>
                                <Button Content="Last 30 Days" 
                                       Command="{x:Bind ViewModel.SetDateRangeCommand}" 
                                       CommandParameter="last30days"
                                       Height="32"
                                       Padding="12,0"/>
                                <Button Content="This Month" 
                                       Command="{x:Bind ViewModel.SetDateRangeCommand}" 
                                       CommandParameter="thismonth"
                                       Height="32"
                                       Padding="12,0"/>
                                <Button Content="Last Month" 
                                       Command="{x:Bind ViewModel.SetDateRangeCommand}" 
                                       CommandParameter="lastmonth"
                                       Height="32"
                                       Padding="12,0"/>
                                <Button Content="This Year" 
                                       Command="{x:Bind ViewModel.SetDateRangeCommand}" 
                                       CommandParameter="thisyear"
                                       Height="32"
                                       Padding="12,0"/>
                            </StackPanel>
                        </StackPanel>
                        
                        <!-- Custom Date Range -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="Start Date" FontSize="12" Margin="0,0,0,4"/>
                                <CalendarDatePicker Date="{x:Bind ViewModel.StartDate, Mode=TwoWay}" 
                                                  Width="150"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                <TextBlock Text="End Date" FontSize="12" Margin="0,0,0,4"/>
                                <CalendarDatePicker Date="{x:Bind ViewModel.EndDate, Mode=TwoWay}" 
                                                  Width="150"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,16,0">
                                <TextBlock Text="Period" FontSize="12" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{x:Bind ViewModel.PeriodTypes}"
                                         SelectedItem="{x:Bind ViewModel.SelectedPeriodItem, Mode=TwoWay}"
                                         DisplayMemberPath="Name"
                                         Width="120"/>
                            </StackPanel>

                            <Button Grid.Column="3" 
                                   Content="Apply Filter"
                                   Command="{x:Bind ViewModel.ApplyFilterCommand}"
                                   VerticalAlignment="Bottom"
                                   Style="{StaticResource AccentButtonStyle}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Summary Cards -->
            <Grid Grid.Row="1" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Total Revenue Card -->
                <Border Grid.Column="0" 
                       Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                       BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                       BorderThickness="1"
                       CornerRadius="8"
                       Padding="16"
                       Margin="0,0,8,0">
                    <ToolTipService.ToolTip>
                        <ToolTip Content="Tổng doanh thu từ tất cả đơn hàng trong khoảng thời gian đã chọn"/>
                    </ToolTipService.ToolTip>
                    <StackPanel Spacing="8">
                        <TextBlock Text="💰 Total Revenue" 
                                  FontSize="14" 
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.TotalRevenueText, Mode=OneWay}" 
                                  FontSize="20" 
                                  FontWeight="Bold"/>
                        
                        <!-- Comparison with previous period -->
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="{x:Bind ViewModel.RevenueIncreased, Mode=OneWay, Converter={StaticResource BoolToArrowConverter}}" 
                                     FontSize="12">
                                <FontIcon.Foreground>
                                    <SolidColorBrush Color="{x:Bind ViewModel.RevenueStatusColor, Mode=OneWay, Converter={StaticResource StringToColorConverter}}"/>
                                </FontIcon.Foreground>
                            </FontIcon>
                            <TextBlock Text="{x:Bind ViewModel.RevenueChangeText, Mode=OneWay}" 
                                      FontSize="12"
                                      FontWeight="SemiBold">
                                <TextBlock.Foreground>
                                    <SolidColorBrush Color="{x:Bind ViewModel.RevenueStatusColor, Mode=OneWay, Converter={StaticResource StringToColorConverter}}"/>
                                </TextBlock.Foreground>
                            </TextBlock>
                            <TextBlock Text="so với kỳ trước" 
                                      FontSize="11" 
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                        
                        <TextBlock Text="Tổng doanh thu" 
                                  FontSize="11" 
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Total Profit Card -->
                <Border Grid.Column="1" 
                       Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                       BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                       BorderThickness="1"
                       CornerRadius="8"
                       Padding="16"
                       Margin="0,0,8,0">
                    <ToolTipService.ToolTip>
                        <ToolTip Content="Tổng lợi nhuận = Doanh thu - Chi phí nhập hàng"/>
                    </ToolTipService.ToolTip>
                    <StackPanel Spacing="8">
                        <TextBlock Text="📈 Total Profit" 
                                  FontSize="14" 
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.TotalProfitText, Mode=OneWay}" 
                                  FontSize="20" 
                                  FontWeight="Bold"/>
                        
                        <!-- Comparison with previous period -->
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="{x:Bind ViewModel.ProfitIncreased, Mode=OneWay, Converter={StaticResource BoolToArrowConverter}}" 
                                     FontSize="12">
                                <FontIcon.Foreground>
                                    <SolidColorBrush Color="{x:Bind ViewModel.ProfitStatusColor, Mode=OneWay, Converter={StaticResource StringToColorConverter}}"/>
                                </FontIcon.Foreground>
                            </FontIcon>
                            <TextBlock Text="{x:Bind ViewModel.ProfitChangeText, Mode=OneWay}" 
                                      FontSize="12"
                                      FontWeight="SemiBold">
                                <TextBlock.Foreground>
                                    <SolidColorBrush Color="{x:Bind ViewModel.ProfitStatusColor, Mode=OneWay, Converter={StaticResource StringToColorConverter}}"/>
                                </TextBlock.Foreground>
                            </TextBlock>
                            <TextBlock Text="so với kỳ trước" 
                                      FontSize="11" 
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                        
                        <TextBlock Text="Tổng lợi nhuận" 
                                  FontSize="11" 
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Total Orders Card -->
                <Border Grid.Column="2" 
                       Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                       BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                       BorderThickness="1"
                       CornerRadius="8"
                       Padding="16"
                       Margin="0,0,8,0">
                    <ToolTipService.ToolTip>
                        <ToolTip Content="Tổng số đơn hàng đã tạo trong khoảng thời gian"/>
                    </ToolTipService.ToolTip>
                    <StackPanel Spacing="8">
                        <TextBlock Text="🛒 Total Orders" 
                                  FontSize="14" 
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.TotalOrdersText, Mode=OneWay}" 
                                  FontSize="20" 
                                  FontWeight="Bold"/>
                        
                        <!-- Comparison with previous period -->
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="{x:Bind ViewModel.OrdersIncreased, Mode=OneWay, Converter={StaticResource BoolToArrowConverter}}" 
                                     FontSize="12">
                                <FontIcon.Foreground>
                                    <SolidColorBrush Color="{x:Bind ViewModel.OrdersIncreased, Mode=OneWay, Converter={StaticResource BoolToGreenRedConverter}}"/>
                                </FontIcon.Foreground>
                            </FontIcon>
                            <TextBlock Text="{x:Bind ViewModel.OrdersChangeText, Mode=OneWay}" 
                                      FontSize="12"
                                      FontWeight="SemiBold">
                                <TextBlock.Foreground>
                                    <SolidColorBrush Color="{x:Bind ViewModel.OrdersIncreased, Mode=OneWay, Converter={StaticResource BoolToGreenRedConverter}}"/>
                                </TextBlock.Foreground>
                            </TextBlock>
                            <TextBlock Text="so với kỳ trước" 
                                      FontSize="11" 
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                        
                        <TextBlock Text="Số đơn hàng" 
                                  FontSize="11" 
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Average Order Value Card -->
                <Border Grid.Column="3" 
                       Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                       BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                       BorderThickness="1"
                       CornerRadius="8"
                       Padding="16"
                       Margin="0,0,8,0">
                    <ToolTipService.ToolTip>
                        <ToolTip Content="Giá trị trung bình mỗi đơn hàng = Tổng doanh thu / Số đơn hàng"/>
                    </ToolTipService.ToolTip>
                    <StackPanel Spacing="8">
                        <TextBlock Text="💵 Avg Order Value" 
                                  FontSize="14" 
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.AverageOrderValueText, Mode=OneWay}" 
                                  FontSize="20" 
                                  FontWeight="Bold"/>
                        <TextBlock Text="Giá trị TB/đơn" 
                                  FontSize="11" 
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Profit Margin Card with Progress Bar -->
                <Border Grid.Column="4" 
                       Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                       BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                       BorderThickness="1"
                       CornerRadius="8"
                       Padding="16">
                    <ToolTipService.ToolTip>
                        <ToolTip Content="Tỷ suất lợi nhuận = (Lợi nhuận / Doanh thu) × 100%"/>
                    </ToolTipService.ToolTip>
                    <StackPanel Spacing="8">
                        <TextBlock Text="📊 Profit Margin" 
                                  FontSize="14" 
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.ProfitMarginText, Mode=OneWay}" 
                                  FontSize="20" 
                                  FontWeight="Bold"/>
                        
                        <!-- Progress Bar -->
                        <ProgressBar Value="{x:Bind ViewModel.ProfitMarginValue, Mode=OneWay}" 
                                    Maximum="100"
                                    Height="8"
                                    CornerRadius="4">
                            <ProgressBar.Foreground>
                                <SolidColorBrush Color="{x:Bind ViewModel.ProfitMarginStatusColor, Mode=OneWay, Converter={StaticResource StringToColorConverter}}"/>
                            </ProgressBar.Foreground>
                        </ProgressBar>
                        
                        <!-- Status indicator -->
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="{x:Bind ViewModel.ProfitMarginStatusColor, Mode=OneWay, Converter={StaticResource StringToColorConverter}}"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock FontSize="11" 
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}">
                                <Run Text="{x:Bind ViewModel.ProfitMarginValue, Mode=OneWay, Converter={StaticResource DoubleToMarginStatusConverter}}"/>
                            </TextBlock>
                        </StackPanel>
                        
                        <TextBlock Text="Tỷ suất lợi nhuận" 
                                  FontSize="11" 
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Product Sales Chart -->
            <Grid Grid.Row="2" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Line Chart -->
                <Border Grid.Column="0"
                       Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                       BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                       BorderThickness="1"
                       CornerRadius="8"
                       Padding="24"
                       Margin="0,0,12,0">
                    <StackPanel Spacing="16">
                        <TextBlock Text="📦 Product Sales Over Time" 
                                  FontSize="20" 
                                  FontWeight="SemiBold"/>
                        
                        <lvc:CartesianChart Series="{x:Bind ViewModel.ProductSalesSeriesCollection, Mode=OneWay}"
                                           XAxes="{x:Bind ViewModel.ProductSalesXAxes, Mode=OneWay}"
                                           YAxes="{x:Bind ViewModel.ProductSalesYAxes, Mode=OneWay}"
                                           Height="400"
                                           LegendPosition="Right"/>
                    </StackPanel>
                </Border>

                <!-- Pie Chart -->
                <Border Grid.Column="1"
                       Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                       BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                       BorderThickness="1"
                       CornerRadius="8"
                       Padding="24">
                    <StackPanel Spacing="16">
                        <TextBlock Text="🥧 Revenue Distribution" 
                                  FontSize="20" 
                                  FontWeight="SemiBold"/>
                        
                        <lvc:PieChart Series="{x:Bind ViewModel.ProductRevenueDistributionSeries, Mode=OneWay}"
                                     Height="400"
                                     LegendPosition="Bottom"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Top 5 Products Leaderboard -->
            <Border Grid.Row="4"
                   Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                   BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                   BorderThickness="1"
                   CornerRadius="8"
                   Padding="24"
                   Margin="0,0,0,24">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE734;" 
                                 FontSize="24"
                                 Foreground="#FFD700"/>
                        <TextBlock Text="🏆 Top 5 Products Leaderboard" 
                                  FontSize="20" 
                                  FontWeight="SemiBold"
                                  VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border Height="1" 
                           Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                    <!-- Leaderboard Items -->
                    <ItemsControl ItemsSource="{x:Bind ViewModel.TopProducts, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProductLeaderboardItem">
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                       CornerRadius="8"
                                       Padding="16"
                                       Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Rank Badge -->
                                        <Border Grid.Row="0" Grid.Column="0"
                                               Width="40" Height="40"
                                               CornerRadius="20"
                                               Margin="0,0,16,0"
                                               VerticalAlignment="Center">
                                            <Border.Background>
                                                <SolidColorBrush Color="{x:Bind BarColor, Mode=OneWay, Converter={StaticResource StringToColorConverter}}"/>
                                            </Border.Background>
                                            <TextBlock Text="{x:Bind Rank}" 
                                                      FontSize="18" 
                                                      FontWeight="Bold"
                                                      Foreground="White"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Product Info -->
                                        <StackPanel Grid.Row="0" Grid.Column="1" 
                                                   VerticalAlignment="Center"
                                                   Spacing="4">
                                            <TextBlock Text="{x:Bind ProductName}" 
                                                      FontSize="15" 
                                                      FontWeight="SemiBold"/>
                                            <StackPanel Orientation="Horizontal" Spacing="16">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="Sold:" 
                                                              FontSize="12" 
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    <TextBlock Text="{x:Bind QuantitySold}" 
                                                              FontSize="12" 
                                                              FontWeight="SemiBold"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="Revenue:" 
                                                              FontSize="12" 
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    <TextBlock Text="{x:Bind RevenueText}" 
                                                              FontSize="12" 
                                                              FontWeight="SemiBold"
                                                              Foreground="#4CAF50"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Percentage -->
                                        <TextBlock Grid.Row="0" Grid.Column="2"
                                                  VerticalAlignment="Center"
                                                  Margin="16,0,0,0">
                                            <Run Text="{x:Bind ProgressPercentage, Mode=OneWay, Converter={StaticResource DoubleToPercentageConverter}}" 
                                                 FontSize="16" 
                                                 FontWeight="Bold"/>
                                            <Run Text="%" FontSize="12"/>
                                        </TextBlock>

                                        <!-- Progress Bar -->
                                        <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                    Value="{x:Bind ProgressPercentage, Mode=OneWay}"
                                                    Maximum="100"
                                                    Height="8"
                                                    CornerRadius="4"
                                                    Margin="0,8,0,0">
                                            <ProgressBar.Foreground>
                                                <SolidColorBrush Color="{x:Bind BarColor, Mode=OneWay, Converter={StaticResource StringToColorConverter}}"/>
                                            </ProgressBar.Foreground>
                                        </ProgressBar>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Revenue & Profit Chart -->
            <Border Grid.Row="5"
                   Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                   BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                   BorderThickness="1"
                   CornerRadius="8"
                   Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="💰 Revenue &amp; Profit Analysis" 
                              FontSize="20" 
                              FontWeight="SemiBold"/>
                    
                    <lvc:CartesianChart Series="{x:Bind ViewModel.RevenueProfitSeriesCollection, Mode=OneWay}"
                                       XAxes="{x:Bind ViewModel.RevenueProfitXAxes, Mode=OneWay}"
                                       YAxes="{x:Bind ViewModel.RevenueProfitYAxes, Mode=OneWay}"
                                       Height="400"
                                       LegendPosition="Right"/>
                </StackPanel>
            </Border>

            <!-- Loading Overlay -->
            <Border Grid.Row="0" Grid.RowSpan="6"
                   Background="#80000000"
                   Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                   VerticalAlignment="Stretch"
                   HorizontalAlignment="Stretch">
                <ProgressRing IsActive="True" 
                             Width="60" 
                             Height="60"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>