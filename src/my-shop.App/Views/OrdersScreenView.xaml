<Page
    x:Class="my_shop.App.Views.OrdersScreenView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:my_shop.App.Models" 
    xmlns:local="using:my_shop.App.Converters"
    x:Name="PageRoot">

    <Page.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:BoolToExpandIconConverter x:Key="BoolToExpandIconConverter"/>
    </Page.Resources>

    <Grid Padding="12,12,12,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.Resources>
            <ThemeShadow x:Name="SharedShadow" />
        </Grid.Resources>

        <!-- Header Section -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="8">
                <TextBlock Text="Orders Management" 
                           Style="{StaticResource TitleTextBlockStyle}"
                           FontSize="28"
                           FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="Total:" 
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontSize="14"/>
                    <TextBlock Text="{x:Bind ViewModel.TotalOrders, Mode=OneWay}" 
                               FontWeight="SemiBold"
                               FontSize="14"/>
                    <TextBlock Text="orders" 
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontSize="14"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Orders List -->
        <Border Grid.Row="2" 
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                BorderThickness="1" 
                CornerRadius="8" 
                Padding="10,10,10,20"
                Shadow="{StaticResource SharedShadow}" >
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" 
                              Width="48"
                              Height="48"
                              HorizontalAlignment="Center"/>

                <ScrollViewer Grid.Row="0"
                              Padding="24"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Orders, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:Order">
                                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="8" 
                                            Padding="16" 
                                            Margin="0,0,0,12">
                                        <StackPanel Spacing="16">
                                            <!-- Header -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Left: Info Section -->
                                                <StackPanel Grid.Column="0" 
                                                            Orientation="Horizontal" 
                                                            Spacing="12"
                                                            VerticalAlignment="Center">
                                                    <!-- Expand Button -->
                                                    <Button Width="32" 
                                                            Height="32"
                                                            Padding="0"
                                                            Click="ToggleButton_Click"
                                                            Tag="{x:Bind}"
                                                            Background="Transparent"
                                                            BorderBrush="Transparent">
                                                        <FontIcon Glyph="{x:Bind IsExpanded, Mode=OneWay, Converter={StaticResource BoolToExpandIconConverter}}" 
                                                                  FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                                  FontSize="12"/>
                                                    </Button>

                                                    <!-- Order Info -->
                                                    <StackPanel Spacing="4">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <TextBlock Text="OrderID #" 
                                                                       FontSize="13"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                            <TextBlock Text="{x:Bind Id}" 
                                                                       FontWeight="SemiBold"
                                                                       FontSize="13"/>
                                                            <TextBlock Text="-" 
                                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                       Margin="4,0"/>
                                                            <TextBlock Text="{x:Bind StatusDisplay, Mode=OneWay}" 
                                                                       FontSize="13"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                        </StackPanel>

                                                        <TextBlock Text="{x:Bind FormattedDate}" 
                                                                   FontSize="12"
                                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>

                                                        <StackPanel Orientation="Horizontal">
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <FontIcon Glyph="&#xE77B;" FontSize="12" Margin="0,0,0,7"/>
                                                                <TextBlock Text="{x:Bind Customer.Name}"/>
                                                                <TextBlock Text="-"/>
                                                                <TextBlock Text="{x:Bind Customer.Phone}"/>
                                                            </StackPanel>
                                                            <Button Width="28" 
                                                                    Height="28"
                                                                    Padding="0"
                                                                    Command="{Binding ElementName=PageRoot, Path=ViewModel.ShowCustomerDetailCommand}"
                                                                    CommandParameter="{x:Bind Customer}"
                                                                    Background="Transparent"
                                                                    BorderBrush="{ThemeResource AccentControlElevationBorderBrush}"
                                                                    BorderThickness="0"
                                                                    CornerRadius="14"
                                                                    VerticalAlignment="Top"
                                                                    ToolTipService.ToolTip="View customer details">
                                                                <FontIcon Glyph="&#xE946;" 
                                                                          Margin="0,0,0,5"
                                                                          FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                                          FontSize="10"
                                                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                                            </Button>
                                                        </StackPanel>

                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <FontIcon Glyph="&#xE7B8;" 
                                                                      FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                                      FontSize="12"
                                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                                            <TextBlock Text="{x:Bind TotalItems}" 
                                                                       FontSize="12"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                            <TextBlock Text="items" 
                                                                       FontSize="12"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Right: Action Buttons & Badges -->
                                                <StackPanel Grid.Column="2" 
                                                                VerticalAlignment="Top"
                                                                HorizontalAlignment="Right">
                                                    <StackPanel>
                                                        <Grid HorizontalAlignment="Right">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <Button Grid.Column="0" 
                                                                    Click="EditButton_Click"
                    Tag="{x:Bind}"
                    Width="36"
                    Height="36"
                    Padding="0"
                    Margin="0,0,10,0"
                    CornerRadius="20"
                    BorderBrush="#10B981"
                    BorderThickness="1"
                    HorizontalAlignment="Left"
                    ToolTipService.ToolTip="Edit order">
                                                                <Button.Visibility>
                                                                    <Binding Path="IsCreated" Mode="OneWay">
                                                                        <Binding.Converter>
                                                                            <local:BoolToVisibilityConverter/>
                                                                        </Binding.Converter>
                                                                    </Binding>
                                                                </Button.Visibility>
                                                                <Button.Resources>
                                                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#34D399"/>
                                                                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#34D399"/>
                                                                </Button.Resources>
                                                                <FontIcon Glyph="&#xE70F;"
                          FontFamily="{StaticResource SymbolThemeFontFamily}"
                          FontSize="12"
                          Foreground="#10B981"/>
                                                            </Button>

                                                            <Button Grid.Column="1" 
            Click="PrintButton_Click"
            Tag="{x:Bind}"
            Width="36"
            Height="36"
            Padding="0"
            Margin="0,0,10,0"
            CornerRadius="20"
            BorderBrush="Black"
            BorderThickness="1"
            HorizontalAlignment="Left"
            ToolTipService.ToolTip="Print Invoice">
                                                                <Button.Visibility>
                                                                    <Binding Path="IsPaid" Mode="OneWay">
                                                                        <Binding.Converter>
                                                                            <local:BoolToVisibilityConverter/>
                                                                        </Binding.Converter>
                                                                    </Binding>
                                                                </Button.Visibility>
                                                                <Button.Resources>
                                                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="DimGray"/>
                                                                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="DimGray"/>
                                                                </Button.Resources>
                                                                <FontIcon Glyph="&#xE749;"
                  FontFamily="{StaticResource SymbolThemeFontFamily}"
                  FontSize="12"
                  Foreground="Black"/>
                                                            </Button>

                                                            <!-- Created Status: Pay & Cancel Buttons -->
                                                            <Button Grid.Column="2" 
                                                                Click="PayButton_Click"
                                                                Tag="{x:Bind}"
                                                                Width="36"
                                                                Height="36"
                                                                Padding="0"
                                                                Margin="0,0,10,0"
                                                                CornerRadius="20"
                                                                BorderBrush="#3875c9"
                                                                BorderThickness="1"
                                                                HorizontalAlignment="Left"
                                                                ToolTipService.ToolTip="Thanh toán"
                                                                >
                                                                <Button.Visibility>
                                                                    <Binding Path="IsCreated" Mode="OneWay">
                                                                        <Binding.Converter>
                                                                            <local:BoolToVisibilityConverter/>
                                                                        </Binding.Converter>
                                                                    </Binding>
                                                                </Button.Visibility>
                                                                <Button.Resources>
                                                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#588fdb"/>
                                                                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#588fdb"/>
                                                                </Button.Resources>
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <FontIcon Glyph="&#xE7BF;"
                                                                          FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                                          FontSize="12"
                                                                              Foreground="#3875c9"/>
                                                                </StackPanel>
                                                            </Button>

                                                            <Button Grid.Column="3" Click="CancelButton_Click"
                                                                    Tag="{x:Bind}"
                                                                    Width="36"
                                                                    Height="36"
                                                                    Padding="0"
                                                                    CornerRadius="20"
                                                                    BorderBrush="#EF4444"
                                                                    BorderThickness="1"
                                                                    HorizontalAlignment="Left"
                                                                    ToolTipService.ToolTip="Hủy đơn">
                                                                <Button.Visibility>
                                                                    <Binding Path="IsCreated" Mode="OneWay">
                                                                        <Binding.Converter>
                                                                            <local:BoolToVisibilityConverter/>
                                                                        </Binding.Converter>
                                                                    </Binding>
                                                                </Button.Visibility>
                                                                <Button.Resources>
                                                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#e8879a"/>
                                                                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FECACA"/>
                                                                </Button.Resources>
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <FontIcon Glyph="&#xE711;" 
                                                                              FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                                              FontSize="12"
                                                                              Foreground="#EF4444"/>
                                                                </StackPanel>
                                                            </Button>

                                                            <!-- Paid Badge -->
                                                            <Border Grid.Column="4" 
                                                                Width="36"
        Height="36"
        Background="{ThemeResource SystemFillColorSuccessBrush}"
        CornerRadius="20"
        VerticalAlignment="Center"
                                                                    HorizontalAlignment="Center">
                                                                <Border.Visibility>
                                                                    <Binding Path="IsPaid" Mode="OneWay">
                                                                        <Binding.Converter>
                                                                            <local:BoolToVisibilityConverter/>
                                                                        </Binding.Converter>
                                                                    </Binding>
                                                                </Border.Visibility>
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                    <FontIcon Glyph="&#xE73E;" 
                                                                          FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                                          FontSize="12"
                                                                          Foreground="White"/>
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- Cancelled Badge -->
                                                            <Border Grid.Column="5" 
                                                                    Width="36"
        Height="36"
        Background="{ThemeResource SystemFillColorCriticalBrush}"
        CornerRadius="20"
        VerticalAlignment="Center">
                                                                <Border.Visibility>
                                                                    <Binding Path="IsCancelled" Mode="OneWay">
                                                                        <Binding.Converter>
                                                                            <local:BoolToVisibilityConverter/>
                                                                        </Binding.Converter>
                                                                    </Binding>
                                                                </Border.Visibility>
                                                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                                    <FontIcon Glyph="&#xE711;" 
                                                                          FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                                          FontSize="12"
                                                                          Foreground="White"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </Grid>
                                                    </StackPanel>
                                                    <Border 
                                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                                CornerRadius="6"
                                                                Padding="16,12"
                                                                Margin="0,10,0,0"
                                                                HorizontalAlignment="Right">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                  <TextBlock Text="Total:" 
                                                                             FontSize="13"
                                                                             Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                             VerticalAlignment="Center"/>
                                                                  <TextBlock Text="{x:Bind FormattedPrice}" 
                                                                             FontSize="13" 
                                                                             FontWeight="SemiBold"
                                                                             VerticalAlignment="Center"/>
                                                             </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Expanded Order Details -->
                                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                    BorderThickness="1" 
                                                    CornerRadius="6" 
                                                    Padding="16">
                                                <Border.Visibility>
                                                    <Binding Path="IsExpanded" Mode="TwoWay">
                                                        <Binding.Converter>
                                                            <local:BoolToVisibilityConverter/>
                                                        </Binding.Converter>
                                                    </Binding>
                                                </Border.Visibility>

                                                <StackPanel Spacing="12">
                                                    <!-- Details Header -->
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <FontIcon Glyph="&#xE8FD;" 
                                                                  FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                                  FontSize="14"
                                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                                        <TextBlock Text="Order details" 
                                                                   FontWeight="SemiBold"
                                                                   FontSize="13"/>
                                                    </StackPanel>

                                                    <!-- Order Items Table Header -->
                                                    <Grid Padding="0,8,0,4" 
                                                          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                          BorderThickness="0,0,0,1"
                                                          ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="90"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="140"/>
                                                            <ColumnDefinition Width="90"/>
                                                            <ColumnDefinition Width="140"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0" 
                                                                   Text="SKU Code" 
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                        <TextBlock Grid.Column="1" 
                                                                   Text="Product" 
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                        <TextBlock Grid.Column="2" 
                                                                   Text="Unit Price" 
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   TextAlignment="Right"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                        <TextBlock Grid.Column="3" 
                                                                   Text="Quantity" 
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   TextAlignment="Center"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                        <TextBlock Grid.Column="4" 
                                                                   Text="Total" 
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   TextAlignment="Right"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    </Grid>

                                                    <!-- Order Items -->
                                                    <ItemsControl ItemsSource="{x:Bind OrderItems}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="models:OrderItem">
                                                                <Grid Padding="0,8" 
                                                                      ColumnSpacing="12">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="90"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="140"/>
                                                                        <ColumnDefinition Width="90"/>
                                                                        <ColumnDefinition Width="140"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <TextBlock Grid.Column="0" 
                                                                               Text="{x:Bind Product.Sku}"
                                                                               FontSize="13"
                                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                        <TextBlock 
                                                                               Text="{x:Bind Product.Name}"
                                                                               FontSize="13"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                        <!-- Product Detail Button -->
                                                                        <Button 
                                                                            Width="28" 
                                                                            Height="28"
                                                                            Padding="0"
                                                                            Command="{Binding ElementName=PageRoot, Path=ViewModel.ShowProductDetailCommand}"
                                                                            CommandParameter="{x:Bind Product}"
                                                                            Background="Transparent"
                                                                            BorderBrush="{ThemeResource AccentControlElevationBorderBrush}"
                                                                            BorderThickness="0"
                                                                            CornerRadius="14"
                                                                            HorizontalAlignment="Center"
                                                                            ToolTipService.ToolTip="View product details">
                                                                            <FontIcon Glyph="&#xE946;" 
                                                                                  FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                                                  FontSize="10"
                                                                                  Margin="0,0,0,7"
                                                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                                                        </Button>
                                                                    </StackPanel>
                                                                    <TextBlock Grid.Column="2" 
                                                                               Text="{x:Bind FormattedPrice}" 
                                                                               TextAlignment="Right"
                                                                               FontSize="13"/>
                                                                    <Border Grid.Column="3"
                                                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                                            CornerRadius="4"
                                                                            Padding="8,4"
                                                                            HorizontalAlignment="Center">
                                                                        <TextBlock TextAlignment="Center"
                                                                                   FontSize="13"
                                                                                   FontWeight="SemiBold">
                                                                            <Run Text="×"/>
                                                                            <Run Text="{x:Bind Quantity}"/>
                                                                        </TextBlock>
                                                                    </Border>
                                                                    <TextBlock Grid.Column="4" 
                                                                               Text="{x:Bind FormattedSubtotal}" 
                                                                               FontWeight="SemiBold" 
                                                                               TextAlignment="Right"
                                                                               FontSize="14"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Pagination -->
                <Grid Grid.Row="1"
      Margin="0,16,0,0"
      ColumnSpacing="12"
      HorizontalAlignment="Center"
      VerticalAlignment="Center">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Previous -->
                    <Button Grid.Column="0"
            Width="36"
            Height="36"
            CornerRadius="18"
            Command="{x:Bind ViewModel.PreviousPageCommand}"
            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
                        <FontIcon Glyph="&#xE76B;"
                  FontFamily="{StaticResource SymbolThemeFontFamily}"
                  FontSize="14"/>
                    </Button>

                    <!-- Page Indicator -->
                    <TextBlock Grid.Column="1"
               VerticalAlignment="Center"
               Margin="8,0">
        <Run Text="Page "/>
        <Run Text="{x:Bind ViewModel.CurrentPage, Mode=OneWay}" FontWeight="SemiBold" FontSize="18"/>
        <Run Text=" / "/>
        <Run Text="{x:Bind ViewModel.TotalPages, Mode=OneWay}" FontWeight="SemiBold" FontSize="18"/>
                    </TextBlock>

                    <!-- Next -->
                    <Button Grid.Column="2"
            Width="36"
            Height="36"
            CornerRadius="18"
            Command="{x:Bind ViewModel.NextPageCommand}"
            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
                        <FontIcon Glyph="&#xE76C;"
                  FontFamily="{StaticResource SymbolThemeFontFamily}"
                  FontSize="14"/>
                    </Button>

                </Grid>

            </Grid>
        </Border>

        <Grid Grid.Row="0" 
          Grid.RowSpan="3"
          HorizontalAlignment="Right"
          VerticalAlignment="Top"
          Margin="0,80,12,0"
          Padding="-100,-40,-12.5,10"
          Canvas.ZIndex="999">
            <Expander IsExpanded="{x:Bind ViewModel.IsSearchExpanded, Mode=TwoWay}"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Shadow="{StaticResource SharedShadow}">
                <Expander.Header>
                    <Grid HorizontalAlignment="Right">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0" 
                              Glyph="&#xE71C;" 
                              FontSize="16"
                              Margin="0,0,8,0"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>

                        <TextBlock Grid.Column="1"
                               Text="Advanced Search"
                               FontWeight="SemiBold"
                               FontSize="13"/>
                    </Grid>
                </Expander.Header>

                <Expander.Content>
                    <StackPanel Spacing="16" 
                            Padding="20"
                            Width="600"
                            MaxWidth="600">
                        <!-- Row 1: Date Range -->
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="8">
                                <TextBlock Text="From Date" 
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <CalendarDatePicker Date="{x:Bind ViewModel.SearchFromDate, Mode=TwoWay}"
                                                PlaceholderText="Select start date"
                                                HorizontalAlignment="Stretch"
                                                FontSize="13"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="8">
                                <TextBlock Text="To Date" 
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <CalendarDatePicker Date="{x:Bind ViewModel.SearchToDate, Mode=TwoWay}"
                                                PlaceholderText="Select end date"
                                                HorizontalAlignment="Stretch"
                                                FontSize="13"/>
                            </StackPanel>
                        </Grid>

                        <!-- Row 2: Customer & Product -->
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="3*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Customer Search -->
                            <StackPanel Grid.Column="0" Spacing="8">
                                <TextBlock Text="Customer" 
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <AutoSuggestBox x:Name="CustomerSearchBox"
                                            PlaceholderText="Search customer..."
                                            QueryIcon="Find"
                                            TextChanged="CustomerSearchBox_TextChanged"
                                            SuggestionChosen="CustomerSearchBox_SuggestionChosen"
                                            FontSize="12.5">
                                    <AutoSuggestBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:Customer">
                                            <Grid ColumnSpacing="12" Padding="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <FontIcon Grid.Column="0"
                                                      Glyph="&#xE77B;"
                                                      FontSize="16"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="12"/>
                                                    <TextBlock Text="{x:Bind Phone}" 
                                                           FontSize="10"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </AutoSuggestBox.ItemTemplate>
                                </AutoSuggestBox>
                            </StackPanel>

                            <!-- Product Search -->
                            <StackPanel Grid.Column="1" Spacing="8">
                                <TextBlock Text="Product" 
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <AutoSuggestBox x:Name="ProductSearchBox"
                                            PlaceholderText="Search product..."
                                            QueryIcon="Find"
                                            TextChanged="ProductSearchBox_TextChanged"
                                            SuggestionChosen="ProductSearchBox_SuggestionChosen"
                                            FontSize="12.5">
                                    <AutoSuggestBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:Product">
                                            <Grid ColumnSpacing="12" Padding="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0"
                                                    Width="40" Height="40"
                                                    CornerRadius="4"
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                                    <Image Stretch="UniformToFill" Source="{x:Bind Images[0]}"/>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{x:Bind Sku}" 
                                                           FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </AutoSuggestBox.ItemTemplate>
                                </AutoSuggestBox>
                            </StackPanel>
                        </Grid>

                        <!-- Row 3: Price Range & Status -->
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="8">
                                <TextBlock Text="Min Price (₫)" 
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <NumberBox Value="{x:Bind ViewModel.SearchMinPrice, Mode=TwoWay}"
                                       PlaceholderText="Min price"
                                       SpinButtonPlacementMode="Compact"
                                       Minimum="0"
                                       FontSize="12.5"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="8">
                                <TextBlock Text="Max Price (₫)" 
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <NumberBox Value="{x:Bind ViewModel.SearchMaxPrice, Mode=TwoWay}"
                                       PlaceholderText="Max price"
                                       SpinButtonPlacementMode="Compact"
                                       Minimum="0"
                                       FontSize="12.5"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Spacing="8">
                                <TextBlock Text="Status" 
               FontSize="12"
               FontWeight="SemiBold"
               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <ComboBox x:Name="StatusComboBox"
              PlaceholderText="All statuses"
              HorizontalAlignment="Stretch"
              FontSize="12.5"
              SelectionChanged="StatusComboBox_SelectionChanged">
                                    <ComboBoxItem Content="All" Tag="{x:Null}"/>
                                    <ComboBoxItem Content="Created" Tag="created"/>
                                    <ComboBoxItem Content="Paid" Tag="paid"/>
                                    <ComboBoxItem Content="Cancelled" Tag="cancelled"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Action Buttons -->
                        <Grid ColumnSpacing="12" MaxWidth="190" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                Command="{x:Bind ViewModel.SearchOrdersCommand}"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE721;" FontSize="14"/>
                                    <TextBlock Text="Search"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="1"
                                Command="{x:Bind ViewModel.ClearSearchCommand}"
                                HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE894;" FontSize="14"/>
                                    <TextBlock Text="Clear"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Expander.Content>
            </Expander>
        </Grid>

    </Grid>
</Page>
