<Page
    x:Class="my_shop.App.Views.LoginScreenView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:my_shop.App.Views"
    xmlns:vm="using:my_shop.App.ViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <!-- Style cho TextBox -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#F7FAFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>

        <!-- Style cho PasswordBox -->
        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="#F7FAFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,12,50,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>

        <!-- Style cho Button Login -->
        <Style x:Key="LoginButton" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#667EEA" Offset="0"/>
                        <GradientStop Color="#764BA2" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0,14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootGrid" 
                                                           Storyboard.TargetProperty="Opacity" 
                                                           To="1" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootGrid" 
                                                           Storyboard.TargetProperty="Opacity" 
                                                           To="0.9" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootGrid" 
                                                           Storyboard.TargetProperty="Opacity" 
                                                           To="0.8" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootGrid" 
                                                           Storyboard.TargetProperty="Opacity" 
                                                           To="0.5" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter x:Name="ContentPresenter"
                                            Content="{TemplateBinding Content}"
                                            ContentTemplate="{TemplateBinding ContentTemplate}"
                                            Padding="{TemplateBinding Padding}"
                                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                            Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Section - Welcome -->
        <Grid Grid.Column="0">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#667EEA" Offset="0"/>
                    <GradientStop Color="#764BA2" Offset="0.5"/>
                    <GradientStop Color="#F093FB" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <!-- Decorative Circle 1 -->
            <Ellipse Width="400" Height="400" 
                    Margin="-200,-200,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Opacity="0.15">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="White" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="0.7"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Decorative Circle 2 -->
            <Ellipse Width="300" Height="300" 
                    Margin="0,0,-150,-150"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Opacity="0.1">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="White" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="0.7"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Logo -->
            <Border Width="110" Height="45" 
                    Background="White" 
                    CornerRadius="8"
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Top"
                    Margin="30">
                <TextBlock Text="MyShop" 
                         FontSize="24" 
                         FontWeight="Bold"
                         Foreground="#667EEA"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>
            </Border>

            <!-- Welcome Text -->
            <StackPanel HorizontalAlignment="Center" 
                       VerticalAlignment="Center">
                <TextBlock Text="Welcome" 
                         FontSize="72" 
                         FontWeight="Bold"
                         Foreground="White"
                         TextAlignment="Center"/>
                <TextBlock Text="Back!" 
                         FontSize="72" 
                         FontWeight="Bold"
                         Foreground="White"
                         TextAlignment="Center"
                         Margin="0,-20,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Right Section - Login Form -->
        <Grid Grid.Column="1" Background="#F8F9FA">
            <StackPanel MaxWidth="420" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center"
                       Margin="40">

                <!-- Login Header -->
                <TextBlock Text="Login" 
                         FontSize="36" 
                         FontWeight="Bold"
                         Foreground="#2D3748"
                         Margin="0,0,0,12"/>

                <TextBlock Text="Welcome back! Please login to your account." 
                         FontSize="14" 
                         Foreground="#A0AEC0"
                         TextWrapping="Wrap"
                         Margin="0,0,0,40"/>

                <!-- User Name -->
                <TextBlock Text="User Name" 
                         FontSize="14" 
                         FontWeight="SemiBold"
                         Foreground="#4A5568"
                         Margin="0,0,0,8"/>

                <TextBox x:Name="UsernameTextBox"
                       Text="{x:Bind ViewModel.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       PlaceholderText="username@gmail.com"
                       Style="{StaticResource ModernTextBox}"
                       Margin="0,0,0,24"/>

                <!-- Password -->
                <TextBlock Text="Password" 
                         FontSize="14" 
                         FontWeight="SemiBold"
                         Foreground="#4A5568"
                         Margin="0,0,0,8"/>

                <Grid Margin="0,0,0,24">
                    <PasswordBox x:Name="PasswordBox"
                             Password="{x:Bind ViewModel.Password, Mode=TwoWay}"
                             PlaceholderText="••••••••"
                             IsPasswordRevealButtonEnabled="False"
                             Style="{StaticResource ModernPasswordBox}"
                             PasswordChanged="PasswordBox_PasswordChanged"/>

                    <!-- Nút con mắt -->
                    <Button x:Name="RevealButton"
                            Visibility="Collapsed"
                            Width="40" Height="40"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0,0,15,0"
                            Click="RevealButton_Click">
                        <FontIcon Name="EyeIcon" Glyph="&#xE052;" />
                    </Button>
                </Grid>

                <!-- Remember Me & Forgot Password -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0"
                            Content="Remember Me"
                            IsChecked="{x:Bind ViewModel.RememberMe, Mode=TwoWay}"
                            FontSize="14"
                            Foreground="#4A5568"/>

                    <HyperlinkButton Grid.Column="1"
                                   Padding="0"
                                   Margin="120,0,0,0"
                                   Content="Forgot Password?" 
                                   Foreground="#667EEA"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right"
                                   Command="{x:Bind ViewModel.ForgotPasswordCommand}"/>
                </Grid>

                <!-- Login Button -->
                <Button Content="Login" 
                      Style="{StaticResource LoginButton}"
                      HorizontalAlignment="Stretch"
                      Command="{x:Bind ViewModel.LoginCommand}"
                      Margin="0,0,0,50"/>

                <!-- Signup Link -->
                <StackPanel Orientation="Horizontal" 
                          HorizontalAlignment="Left">
                    <TextBlock Text="New User? " 
                             FontSize="14" 
                             Foreground="#718096"
                             VerticalAlignment="Center"/>
                    <HyperlinkButton Content="Signup" 
                                   Foreground="#667EEA"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Padding="15,0,0,0"
                                   Command="{x:Bind ViewModel.SignupCommand}"/>
                </StackPanel>
            </StackPanel>
            <TextBlock Text="Version 1.0.0" 
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Margin="0,0,20,20"
                       Foreground="#A0AEC0"
                       FontSize="12"
                       FontWeight="SemiBold"/>
        </Grid>

        <Grid Grid.ColumnSpan="2"
              Background="#80000000"
              Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
            <StackPanel HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Spacing="20">
                <!-- Spinner -->
                <ProgressRing IsActive="True"
                             Width="60"
                             Height="60"/>

                <TextBlock Text="Signing in…"
           FontSize="15"
           FontWeight="Medium"
           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>