<Page
x:Class="my_shop.App.Views.VouchersScreenView"
x:Name="PageRoot"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:viewmodels="using:my_shop.App.ViewModels"
xmlns:models="using:my_shop.App.Models"
xmlns:converters="using:my_shop.App.Converters"
mc:Ignorable="d"
Background="{ThemeResource LayerFillColorDefaultBrush}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVisibilityConverter"/>
        <converters:InvertedBoolConverter x:Key="InvertedBoolConverter"/>
        <converters:BoolToStringConverter x:Key="BoolToStringConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>
        
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="12,12,12,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Voucher Management" 
                          Style="{ThemeResource TitleLargeTextBlockStyle}"
                          FontWeight="SemiBold"
                           FontSize="32"/>
                <TextBlock Text="Create and manage discount codes for customers" 
                          Style="{ThemeResource BodyTextBlockStyle}"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          Margin="0,10,0,0"/>
            </StackPanel>

            <Button Grid.Column="1"
                   Command="{x:Bind ViewModel.NewVoucherCommand}"
                   Style="{ThemeResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Create Voucher"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1" Padding="12,0,12,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Vouchers List -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
            Orientation="Horizontal"
            Spacing="16"
            Margin="0,0,0,16">

                        <TextBlock Text="Voucher"
               Style="{ThemeResource SubtitleTextBlockStyle}"
               FontWeight="SemiBold"/>
                    </StackPanel>


                    <ProgressRing Grid.Row="1" 
                                 IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                 Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>

                    <ScrollViewer Grid.Row="1" 
                                 VerticalScrollBarVisibility="Auto"
                                 Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Vouchers, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:VoucherModel">
                                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                           CornerRadius="6"
                                           Padding="12"
                                           Margin="0,0,0,8"
                                           BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                           BorderThickness="1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Code & Status -->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0"
            Orientation="Horizontal"
            Spacing="8"
            VerticalAlignment="Center">

                                                    <!-- Voucher / Ticket icon -->
                                                    <FontIcon Glyph="&#xE8C7;" FontSize="16"/>

                                                    <!-- Voucher code -->
                                                    <TextBlock Text="{x:Bind Code}"
               FontWeight="SemiBold"
               FontSize="16"/>
                                                </StackPanel>


                                                <Border Grid.Column="1"
                                                       Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                       CornerRadius="4"
                                                       Padding="8,4">
                                                    <TextBlock Text="{x:Bind DisplayStatus}"
                                                              FontSize="12"
                                                              Foreground="White"/>
                                                </Border>
                                            </Grid>

                                            <!-- Description -->
                                            <TextBlock Grid.Row="1"
                                                      Text="{x:Bind Description}"
                                                      TextWrapping="Wrap"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                      FontSize="13"
                                                      Margin="0,6,0,0"
                                                      Visibility="{x:Bind Description, Converter={StaticResource StringToVisibilityConverter}}"/>

                                            <!-- Info -->
                                            <StackPanel Grid.Row="2" Spacing="4" Margin="0,8,0,0">
                                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                    <Run Text="Discount:"/>
                                                    <Run Text="{x:Bind DisplayDiscount}" FontWeight="SemiBold"/>
                                                </TextBlock>
                                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                    <Run Text="Used:"/>
                                                    <Run Text="{x:Bind DisplayUsage}" FontWeight="SemiBold"/>
                                                </TextBlock>
                                                <TextBlock Text="{x:Bind DisplayMinOrder}"
                                                          FontSize="12" 
                                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>

                                            <!-- Action Buttons -->
                                            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="4" Margin="0,8,0,0" HorizontalAlignment="Right">
                                                <Button Click="EditButton_Click"
                                                       Tag="{x:Bind}"
                                                       Style="{ThemeResource SubtleButtonStyle}"
                                                       ToolTipService.ToolTip="Edit">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <FontIcon Glyph="&#xE70F;" FontSize="14"/>
                                                        <TextBlock Text="Edit" FontSize="12"/>
                                                    </StackPanel>
                                                </Button>

                                                <Button Click="DeleteButton_Click"
                                                       Tag="{x:Bind}"
                                                       Style="{ThemeResource SubtleButtonStyle}"
                                                       ToolTipService.ToolTip="Clear">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                                                        <TextBlock Text="Clear" FontSize="12"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Form -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="12,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <TextBlock Text="{x:Bind ViewModel.IsEditMode, Mode=OneWay, Converter={StaticResource BoolToStringConverter}, ConverterParameter='Chỉnh sửa Voucher|Create voucher'}"
                                  Style="{ThemeResource SubtitleTextBlockStyle}"
                                  FontWeight="SemiBold"/>

                        <!-- Error Message -->
                        <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                                Severity="Error"
                                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"/>

                        <!-- Code -->
                        <StackPanel>
                            <TextBlock Text="Voucher code *" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox Text="{x:Bind ViewModel.Code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="VD: SUMMER2026"
                                    CharacterCasing="Upper"/>
                        </StackPanel>

                        <!-- Description -->
                        <StackPanel>
                            <TextBlock Text="Description" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox Text="{x:Bind ViewModel.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Description something about this voucher"
                                    AcceptsReturn="True"
                                    Height="80"
                                    TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Discount Settings -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Discount (%) *" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <NumberBox Value="{x:Bind ViewModel.DiscountPercent, Mode=TwoWay}"
                                          SpinButtonPlacementMode="Inline"
                                          Minimum="1"
                                          Maximum="100"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Maximum reduction (đ) *" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <NumberBox Value="{x:Bind ViewModel.MaxDiscountAmount, Mode=TwoWay}"
                                          SpinButtonPlacementMode="Inline"
                                          Minimum="1000"
                                          LargeChange="10000"
                                          SmallChange="1000"/>
                            </StackPanel>
                        </Grid>

                        <!-- Order Settings -->
                        <StackPanel>
                            <TextBlock Text="Minimum order value (đ)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <NumberBox Value="{x:Bind ViewModel.MinOrderAmount, Mode=TwoWay}"
                                      SpinButtonPlacementMode="Inline"
                                      Minimum="0"
                                      LargeChange="10000"
                                      SmallChange="1000"/>
                        </StackPanel>

                        <!-- Quantity Settings -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Quantity *" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <NumberBox Value="{x:Bind ViewModel.TotalQuantity, Mode=TwoWay}"
                                          SpinButtonPlacementMode="Inline"
                                          Minimum="1"
                                          IsEnabled="{x:Bind ViewModel.IsEditMode, Mode=OneWay, Converter={StaticResource InvertedBoolConverter}}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Visibility="{x:Bind ViewModel.IsEditMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="Remains: " FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <NumberBox Value="{x:Bind ViewModel.RemainingQuantity, Mode=TwoWay}"
                                          SpinButtonPlacementMode="Inline"
                                          Minimum="0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Date Range -->
                        <StackPanel>
                            <TextBlock Text="Released date *" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <DatePicker Date="{x:Bind ViewModel.StartDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       HorizontalAlignment="Stretch"/>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="Expired date *" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <DatePicker Date="{x:Bind ViewModel.EndDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       HorizontalAlignment="Stretch"/>
                        </StackPanel>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0" HorizontalAlignment="Right">
                            <Button Command="{x:Bind ViewModel.SaveVoucherCommand}"
                                   Style="{ThemeResource AccentButtonStyle}"
                                   IsEnabled="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InvertedBoolConverter}}">
                                <StackPanel Orientation="Horizontal" Spacing="8" >
                                    <FontIcon Glyph="&#xE7C3;" FontSize="16"/>
                                    <TextBlock Text="{x:Bind ViewModel.IsEditMode, Mode=OneWay, Converter={StaticResource BoolToStringConverter}, ConverterParameter='Update|Create'}"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{x:Bind ViewModel.CancelEditCommand}"
                                   Visibility="{x:Bind ViewModel.IsEditMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE711;" FontSize="16"/>
                                    <TextBlock Text="Hủy"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
