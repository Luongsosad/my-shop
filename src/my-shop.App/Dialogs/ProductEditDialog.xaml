<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="my_shop.App.Dialogs.ProductEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    RequestedTheme="Light"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">800</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">700</x:Double>
    </ContentDialog.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Padding="12" Width="750">
            <!-- Product Name -->
            <TextBox 
                x:Name="NameTextBox"
                Header="
Product name *"
                PlaceholderText="
Enter the product name"/>

            <!-- SKU -->
            <TextBox 
                x:Name="SkuTextBox"
                Header="SKU *"
                PlaceholderText="Enter SKU"/>

            <!-- Price and Stock -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <NumberBox 
                    x:Name="PriceNumberBox"
                    Grid.Column="0"
                    Header="Import price (₫) *"
                    PlaceholderText="0"
                    Minimum="0"
                    SpinButtonPlacementMode="Inline"/>

                <NumberBox 
                    x:Name="StockNumberBox"
                    Grid.Column="1"
                    Header="
Inventory *"
                    PlaceholderText="0"
                    Minimum="0"
                    SpinButtonPlacementMode="Inline"/>
            </Grid>

            <!-- Category -->
            <ComboBox 
                x:Name="CategoryComboBox"
                Header="Category *"
                PlaceholderText="Select category"
                DisplayMemberPath="Name"
                HorizontalAlignment="Stretch"/>

            <!-- Description -->
            <TextBox 
                x:Name="DescriptionTextBox"
                Header="Desciption"
                PlaceholderText="
Enter a product description (optional)"
                TextWrapping="Wrap"
                AcceptsReturn="True"
                Height="100"/>

            <!-- Images Section -->
            <StackPanel Spacing="12">
                <TextBlock Text="Image" FontWeight="SemiBold" FontSize="16"/>
                
                <!-- Upload from Computer -->
                <Button 
                    x:Name="UploadImageButton"
                    Click="UploadImageButton_Click"
                    HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B7;" FontSize="16"/>
                        <TextBlock Text="
Select an image from your computer"/>
                    </StackPanel>
                </Button>
                
                <!-- Upload Status/Error -->
                <TextBlock 
                    x:Name="UploadStatusText"
                    FontSize="12"
                    FontStyle="Italic"
                    Visibility="Collapsed"
                    TextWrapping="Wrap"/>
                
                <!-- Or add URL -->
                <TextBlock Text="
Or enter the URL:" FontSize="12" Foreground="Gray"/>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox 
                        x:Name="ImageUrlTextBox"
                        Grid.Column="0"
                        PlaceholderText="https://example.com/image.jpg"/>

                    <Button 
                        x:Name="AddImageButton"
                        Grid.Column="1"
                        Content="Add URL"
                        Click="AddImageButton_Click"/>
                </Grid>

                <!-- Images List -->
                <ListView 
                    x:Name="ImagesListView"
                    MaxHeight="200"
                    SelectionMode="None"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    CornerRadius="4">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8" BorderBrush="LightGray" BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border 
                                    Grid.Column="0"
                                    Width="70"
                                    Height="70"
                                    CornerRadius="4"
                                    BorderBrush="Gray"
                                    BorderThickness="1">
                                    <Image 
                                        Source="{Binding}"
                                        Stretch="UniformToFill"/>
                                </Border>

                                <TextBlock 
                                    Grid.Column="1"
                                    Text="{Binding}"
                                    VerticalAlignment="Center"
                                    Margin="12,0"
                                    TextTrimming="CharacterEllipsis"/>

                                <Button 
                                    Grid.Column="2"
                                    Click="RemoveImageButton_Click"
                                    Tag="{Binding}"
                                    Background="Transparent">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                                        <TextBlock Text="Delete"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                
                <TextBlock 
                    x:Name="NoImagesText"
                    Text="
No images available. Choose a file or enter a URL"
                    FontSize="12"
                    Foreground="Gray"
                    FontStyle="Italic"
                    HorizontalAlignment="Center"
                    Visibility="Collapsed"/>
            </StackPanel>

            <!-- Required Note -->
            <TextBlock 
                Text="* 
Required field"
                FontSize="12"
                Foreground="Gray"
                FontStyle="Italic"/>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
